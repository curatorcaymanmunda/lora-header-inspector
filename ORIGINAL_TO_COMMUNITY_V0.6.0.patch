+"""Single-stream, joint-attention, and modern image-DiT signatures."""
+
+from __future__ import annotations
+
+from typing import Iterable
+
+from ..models import SignatureMatch
+from ..normalization import DetectionContext
+from .registry import register
+
+
+@register("auraflow", order=40)
+def detect_auraflow(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    diffusers = (
+        ctx.has(
+            r"(?:^|[._])joint_transformer_blocks[._]\d+[._]attn[._]"
+            r"(?:add_[qkv]_proj|to_add_out)(?:[._]|$)"
+        )
+        and ctx.has(
+            r"(?:^|[._])single_transformer_blocks[._]\d+[._]attn[._]"
+            r"(?:to_[qkv]|to_out)(?:[._]|$)"
+        )
+    )
+    original = ctx.has(
+        r"(?:^|[._])double_layers[._]\d+[._]attn[._]w1[qkv](?:[._]|$)"
+    ) or ctx.has(
+        r"(?:^|[._])single_layers[._]\d+[._]attn[._]w1[qkv](?:[._]|$)"
+    )
+    if not diffusers and not original:
+        return []
+    return [
+        SignatureMatch(
+            rule_id="auraflow.joint-single" if diffusers else "auraflow.double-single-native",
+            family="AuraFlowDiT",
+            architecture="AuraFlow",
+            confidence="high",
+            priority=100,
+            message=(
+                "AuraFlow joint/single transformer layout"
+                if diffusers
+                else "AuraFlow double_layers/single_layers w1q layout"
+            ),
+        )
+    ]
+
+
+@register("sd3-native-joint-blocks", order=50)
+def detect_sd3_native(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    if not ctx.has(r"(?:^|[._])joint_blocks[._]\d+[._](?:x_block|context_block)(?:[._]|$)"):
+        return []
+    return [
+        SignatureMatch(
+            rule_id="sd3.joint-blocks-native",
+            family="JointAttentionDiT",
+            architecture="SD3",
+            confidence="high",
+            priority=100,
+            message="SD3 MMDiT joint_blocks x_block/context_block naming",
+        )
+    ]
+
+
+@register("zimage-ideogram4", order=60)
+def detect_zimage_ideogram4(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    zimage_refiner = ctx.has(
+        r"(?:^|[._])(?:noise_refiner|context_refiner)[._]\d+[._]"
+        r"(?:attention|feed_forward)(?:[._]|$)"
+    )
+    ideogram_modules = ctx.has(r"(?:^|[._])(?:llm_cond_proj|embed_image_indicator)(?:[._]|$)")
+    separate_attention = ctx.has(
+        r"(?:^|[._])layers[._]\d+[._]attention[._](?:to_[qkv]|to_out)(?:[._]|$)"
+    )
+    fused_attention = ctx.has(
+        r"(?:^|[._])layers[._]\d+[._]attention[._](?:qkv|o)(?:[._]|$)"
+    )
+    swiglu = ctx.has(r"(?:^|[._])layers[._]\d+[._]feed_forward[._]w[123](?:[._]|$)")
+
+    if zimage_refiner:
+        return [
+            SignatureMatch(
+                rule_id="zimage.refiner-path",
+                family="ZImageDiT",
+                architecture="ZImage",
+                confidence="high",
+                priority=100,
+                message="Z-Image noise/context refiner module naming",
+            )
+        ]
+    if ideogram_modules:
+        return [
+            SignatureMatch(
+                rule_id="ideogram4.llm-indicator-modules",
+                family="Ideogram4DiT",
+                architecture="Ideogram4",
+                confidence="high",
+                priority=100,
+                message="Ideogram 4 LLM-condition/image-indicator module naming",
+            )
+        ]
+    if not (separate_attention or fused_attention or swiglu):
+        return []
+
+    attention_dims = ctx.dims(
+        r"(?:^|[._])layers[._]\d+[._]attention[._](?:to_[qkv]|to_out|qkv|o)"
+    )
+    w2_dims = ctx.dims(r"(?:^|[._])layers[._]\d+[._]feed_forward[._]w2")
+    naming = "fused-qkv" if fused_attention else "separate-qkv"
+    detail = f"layers.N attention ({naming}) + w1/w2/w3 single-stream layout"
+
+    if 3840 in attention_dims or 10240 in w2_dims:
+        return [
+            SignatureMatch(
+                rule_id="zimage.width-signature",
+                family="ZImageDiT",
+                architecture="ZImage",
+                confidence="high",
+                priority=95,
+                message="Z-Image width signature (hidden=3840 or feed-forward=10240)",
+                details=(detail,),
+            )
+        ]
+    if 4608 in attention_dims or 12288 in w2_dims:
+        return [
+            SignatureMatch(
+                rule_id="ideogram4.width-signature",
+                family="Ideogram4DiT",
+                architecture="Ideogram4",
+                confidence="high",
+                priority=95,
+                message="Ideogram 4 width signature (hidden=4608 or feed-forward=12288)",
+                details=(detail,),
+            )
+        ]
+
+    widths = (
+        "unrecognised single-stream widths="
+        f"attention:{','.join(map(str, sorted(attention_dims))) or '-'};"
+        f"w2:{','.join(map(str, sorted(w2_dims))) or '-'}"
+        if attention_dims or w2_dims
+        else "Z-Image/Ideogram-like layout without decisive adapter dimensions"
+    )
+    return [
+        SignatureMatch(
+            rule_id="nextdit.shared-single-stream",
+            family="SingleStreamSwiGLUDiT",
+            confidence="medium",
+            priority=50,
+            ambiguous=True,
+            message=detail,
+            details=(widths,),
+        )
+    ]
+
+
+@register("ernie-image", order=70)
+def detect_ernie_image(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    attention = ctx.has(
+        r"(?:^|[._])layers[._]\d+[._]self_attention[._](?:to_[qkv]|to_out)(?:[._]|$)"
+    )
+    mlp = ctx.has(
+        r"(?:^|[._])layers[._]\d+[._]mlp[._](?:gate_proj|up_proj|linear_fc2)(?:[._]|$)"
+    )
+    if not attention and not mlp:
+        return []
+    attention_dims = ctx.dims(
+        r"(?:^|[._])layers[._]\d+[._]self_attention[._](?:to_[qkv]|to_out)"
+    )
+    fc2_dims = ctx.dims(r"(?:^|[._])layers[._]\d+[._]mlp[._]linear_fc2")
+    details = []
+    if attention_dims or fc2_dims:
+        details.append(
+            "observed ERNIE widths="
+            f"attention:{','.join(map(str, sorted(attention_dims))) or '-'};"
+            f"fc2:{','.join(map(str, sorted(fc2_dims))) or '-'}"
+        )
+    if 3072 in attention_dims or 8192 in fc2_dims or (attention and mlp):
+        return [
+            SignatureMatch(
+                rule_id="ernie-image.layer-signature",
+                family="ErnieImageDiT",
+                architecture="ErnieImage",
+                confidence="high",
+                priority=95,
+                message="ERNIE-Image self_attention + gated MLP signature",
+                details=tuple(details),
+            )
+        ]
+    return [
+        SignatureMatch(
+            rule_id="ernie-image.partial",
+            family="ErnieImageDiT",
+            confidence="medium",
+            priority=50,
+            ambiguous=True,
+            message="partial ERNIE-Image layer signature",
+            details=tuple(details),
+        )
+    ]
+
+
+@register("krea2", order=80)
+def detect_krea2(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    text_fusion = ctx.has(
+        r"(?:^|[._])(?:text_fusion|txtfusion)[._](?:layerwise_blocks|refiner_blocks)[._]\d+"
+    )
+    attention_diffusers = ctx.has(
+        r"(?:^|[._])transformer_blocks[._]\d+[._]attn[._]to_gate(?:[._]|$)"
+    )
+    attention_comfy = ctx.has(
+        r"(?:^|[._])blocks[._]\d+[._]attn[._](?:wq|wk|wv|gate|wo)(?:[._]|$)"
+    )
+    swiglu_diffusers = ctx.has(
+        r"(?:^|[._])transformer_blocks[._]\d+[._]ff[._](?:gate|up|down)(?:[._]|$)"
+    )
+    swiglu_comfy = ctx.has(
+        r"(?:^|[._])blocks[._]\d+[._]mlp[._](?:gate|up|down)(?:[._]|$)"
+    )
+    attention = attention_diffusers or attention_comfy
+    swiglu = swiglu_diffusers or swiglu_comfy
+    if not text_fusion and not (attention and swiglu):
+        return []
+
+    attention_dims = ctx.dims(
+        r"(?:^|[._])(?:transformer_blocks[._]\d+[._]attn[._]"
+        r"(?:to_[qkv]|to_gate|to_out)|blocks[._]\d+[._]attn[._](?:wq|wk|wv|gate|wo))"
+    )
+    ff_down_dims = ctx.dims(
+        r"(?:^|[._])(?:transformer_blocks[._]\d+[._]ff[._]down|"
+        r"blocks[._]\d+[._]mlp[._]down)"
+    )
+    details = []
+    if attention_comfy or swiglu_comfy:
+        details.append("Krea 2 ComfyUI blocks/attn.wq/mlp naming")
+    if attention_dims or ff_down_dims:
+        details.append(
+            "observed Krea 2 widths="
+            f"attention:{','.join(map(str, sorted(attention_dims))) or '-'};"
+            f"ff-down:{','.join(map(str, sorted(ff_down_dims))) or '-'}"
+        )
+    if text_fusion or 6144 in attention_dims or 16384 in ff_down_dims:
+        return [
+            SignatureMatch(
+                rule_id="krea2.gqa-text-fusion-swiglu",
+                family="Krea2DiT",
+                architecture="Krea2",
+                confidence="high",
+                priority=100,
+                message="Krea 2 grouped-query attention/text-fusion/SwiGLU signature",
+                details=tuple(details),
+            )
+        ]
+    return [
+        SignatureMatch(
+            rule_id="krea2.partial",
+            family="Krea2DiT",
+            confidence="medium",
+            priority=50,
+            ambiguous=True,
+            message="partial Krea 2 transformer signature",
+            details=tuple(details),
+        )
+    ]
+
+
+@register("generic-transformer-blocks", order=950)
+def detect_generic_transformer(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    indices = ctx.indices(
+        r"(?:^|[._])transformer_blocks[._](\d+)",
+        r"lora_transformer_transformer_blocks_(\d+)",
+    )
+    if not indices:
+        return []
+
+    if ctx.has(r"(?:^|[._])img_mod(?:[._]|$)") and ctx.has(r"(?:^|[._])txt_mod(?:[._]|$)"):
+        return [
+            SignatureMatch(
+                rule_id="qwen-image.img-txt-mod",
+                family="JointAttentionDiT",
+                architecture="QwenImage",
+                confidence="high",
+                priority=100,
+                message="paired img_mod and txt_mod modules",
+            )
+        ]
+
+    if ctx.has(r"norm1_context|add_[qkv]_proj"):
+        joint_dims = ctx.dims(
+            r"(?:^|[._])transformer_blocks[._]\d+[._]attn2?[._]"
+            r"(?:to_[qkv]|add_[qkv]_proj|to_out|to_add_out)"
+        )
+        known_sd3 = sorted(joint_dims.intersection({1536, 2432}))
+        if len(known_sd3) == 1 and not joint_dims - {1536, 2432}:
+            return [
+                SignatureMatch(
+                    rule_id="sd3.diffusers-width",
+                    family="JointAttentionDiT",
+                    architecture="SD3",
+                    confidence="high",
+                    priority=95,
+                    message=f"joint-attention layout with SD3-family hidden width={known_sd3[0]}",
+                )
+            ]
+        return [
+            SignatureMatch(
+                rule_id="joint-attention.shared-layout",
+                family="JointAttentionDiT",
+                confidence="medium",
+                priority=45,
+                ambiguous=True,
+                message="joint-attention transformer layout; exact architecture unresolved",
+            )
+        ]
+
+    if ctx.has(r"transformer_blocks[._]\d+.*attn1") and ctx.has(
+        r"transformer_blocks[._]\d+.*attn2"
+    ):
+        return [
+            SignatureMatch(
+                rule_id="video-transformer.shared-attn1-attn2",
+                family="VideoTransformerDiT",
+                confidence="medium",
+                priority=35,
+                ambiguous=True,
+                message="attn1/attn2 video-transformer layout; exact architecture unresolved",
+            )
+        ]
+
+    return [
+        SignatureMatch(
+            rule_id="transformer.generic-blocks",
+            family="TransformerDiT",
+            confidence="low",
+            priority=10,
+            ambiguous=True,
+            message="generic transformer_blocks layout",
+        )
+    ]
diff --git a/src/lora_header_inspector/signatures/registry.py b/src/lora_header_inspector/signatures/registry.py
new file mode 100644
index 0000000000000000000000000000000000000000..aae39aa9b91acbd763264c086be4dfb404d91582
--- /dev/null
+++ b/src/lora_header_inspector/signatures/registry.py
@@ -0,0 +1,66 @@
+"""Composable structural signature registry."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Callable, Iterable, List, Sequence, Tuple
+
+from ..models import SignatureMatch
+from ..normalization import DetectionContext, KeyIndex
+
+Detector = Callable[[DetectionContext], Iterable[SignatureMatch]]
+_REGISTERED: List[Tuple[int, str, Detector]] = []
+
+
+def register(name: str, order: int = 100):
+    def decorator(detector: Detector) -> Detector:
+        if any(existing == name for _, existing, _ in _REGISTERED):
+            raise ValueError(f"duplicate structural detector name: {name}")
+        _REGISTERED.append((order, name, detector))
+        _REGISTERED.sort(key=lambda item: (item[0], item[1]))
+        return detector
+    return decorator
+
+
+@dataclass(frozen=True)
+class RegisteredDetector:
+    order: int
+    name: str
+    detector: Detector
+
+
+class SignatureRegistry:
+    def __init__(self, entries: Sequence[Tuple[int, str, Detector]]) -> None:
+        self._entries = tuple(RegisteredDetector(*entry) for entry in entries)
+
+    @property
+    def detector_names(self) -> Tuple[str, ...]:
+        return tuple(item.name for item in self._entries)
+
+    def evaluate(self, index: KeyIndex) -> List[SignatureMatch]:
+        matches: List[SignatureMatch] = []
+        for entry in self._entries:
+            try:
+                matches.extend(entry.detector(index))
+            except Exception as exc:
+                matches.append(SignatureMatch(
+                    rule_id=f"detector.error.{entry.name}",
+                    family="Unknown",
+                    confidence="low",
+                    priority=-100,
+                    ambiguous=True,
+                    message=f"structural detector {entry.name} failed: {exc}",
+                ))
+        return matches
+
+    def summary(self) -> List[dict]:
+        return [
+            {"order": item.order, "name": item.name, "callable": item.detector.__name__}
+            for item in self._entries
+        ]
+
+
+def build_default_registry() -> SignatureRegistry:
+    # Importing builtin performs registration exactly once through Python's module cache.
+    from . import builtin  # noqa: F401
+    return SignatureRegistry(tuple(_REGISTERED))
diff --git a/src/lora_header_inspector/signatures/stable_diffusion.py b/src/lora_header_inspector/signatures/stable_diffusion.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed6b94d4fe66e21f1f80145df2fdb8f77206e63c
--- /dev/null
+++ b/src/lora_header_inspector/signatures/stable_diffusion.py
@@ -0,0 +1,118 @@
+"""Stable Diffusion UNet and text-encoder signatures."""
+
+from __future__ import annotations
+
+from typing import Iterable
+
+from ..models import SignatureMatch
+from ..normalization import DetectionContext
+from .registry import register
+
+
+@register("stable-diffusion-unet", order=10)
+def detect_stable_diffusion_unet(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    unet_layout = ctx.has(
+        r"(?:^|[._])(?:down_blocks|input_blocks|up_blocks|output_blocks|"
+        r"mid_block|middle_block)(?:[._]|$)"
+    )
+    if not unet_layout:
+        return []
+
+    dims = ctx.dims(r"attn2[._]to_k")
+    known = sorted(dims.intersection({768, 1024, 2048}))
+    details = []
+    if len(known) == 1:
+        architecture = {768: "SD15", 1024: "SD2", 2048: "SDXL"}[known[0]]
+        return [
+            SignatureMatch(
+                rule_id=f"sd.unet.cross-attention.{known[0]}",
+                family="SDUNet",
+                architecture=architecture,
+                confidence="high",
+                priority=100,
+                message=f"cross-attention context width={known[0]}",
+            )
+        ]
+    if len(known) > 1:
+        details.append(
+            "multiple incompatible cross-attention widths="
+            + ",".join(str(value) for value in known)
+        )
+        return [
+            SignatureMatch(
+                rule_id="sd.unet.cross-attention-conflict",
+                family="SDUNet",
+                confidence="high",
+                priority=95,
+                ambiguous=True,
+                message=details[0],
+            )
+        ]
+    if dims:
+        details.append(
+            "unrecognised cross-attention width(s)="
+            + ",".join(str(value) for value in sorted(dims))
+        )
+
+    if ctx.has(r"(?:^|[._])lora_te2_|(?:^|[._])text_encoder_2(?:[._]|$)"):
+        return [
+            SignatureMatch(
+                rule_id="sd.unet.second-text-encoder",
+                family="SDUNet",
+                architecture="SDXL",
+                confidence="high",
+                priority=90,
+                message="second text encoder present with UNet layout",
+                details=tuple(details),
+            )
+        ]
+
+    naming = []
+    if ctx.has(r"^lora_unet_input_blocks_"):
+        naming.append("LDM-style input_blocks")
+    if ctx.has(r"^lora_unet_down_blocks_|^unet[._]down_blocks"):
+        naming.append("diffusers-style down_blocks")
+    message = "UNet layout without a decisive cross-attention shape"
+    if naming:
+        message += " (" + ", ".join(naming) + ")"
+    return [
+        SignatureMatch(
+            rule_id="sd.unet.shared-layout",
+            family="SDUNet",
+            confidence="medium" if naming else "low",
+            priority=40,
+            ambiguous=True,
+            message=message,
+            details=tuple(details),
+        )
+    ]
+
+
+@register("stable-diffusion-text-encoder-only", order=900)
+def detect_text_encoder_only(ctx: DetectionContext) -> Iterable[SignatureMatch]:
+    if not ctx.has(r"^lora_te|^text_encoder(?:[._]|$)"):
+        return []
+    if ctx.has(r"(?:down_blocks|input_blocks|up_blocks|output_blocks|transformer_blocks)"):
+        return []
+    if ctx.has(r"^lora_te2_|^text_encoder_2(?:[._]|$)"):
+        return [
+            SignatureMatch(
+                rule_id="sd.text-encoder-only.two-encoders",
+                family="TextEncoderOnly",
+                architecture="SDXL",
+                confidence="medium",
+                priority=35,
+                ambiguous=True,
+                message="two text encoders, no denoiser tensors",
+            )
+        ]
+    return [
+        SignatureMatch(
+            rule_id="sd.text-encoder-only.single-encoder",
+            family="TextEncoderOnly",
+            confidence="low",
+            priority=20,
+            ambiguous=True,
+            message="single text encoder, no denoiser tensors",
+        )
+    ]
diff --git a/src/lora_header_inspector/smoke.py b/src/lora_header_inspector/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..f4c39e6a613e49def55508aacce28f050f52ef08
--- /dev/null
+++ b/src/lora_header_inspector/smoke.py
@@ -0,0 +1,113 @@
+"""Read-only real-file smoke inspection."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import textwrap
+from typing import Optional, Sequence
+
+from .inspection import expand_arg, inspect_one_file
+
+
+def _value(record, field: str, fallback: str = "-") -> str:
+    value = str(record.get(field, "") or "").strip()
+    return value or fallback
+
+
+def print_record(record) -> None:
+    print("\n" + "=" * 80)
+    print(f"LoRA: {_value(record, 'path')}")
+    print("=" * 80)
+    rows = (
+        ("Architecture", _value(record, "arch", "Unknown")),
+        ("Structural family", _value(record, "structural_family", "Unknown")),
+        ("Status", _value(record, "status", "unknown")),
+        ("Confidence", _value(record, "confidence", "low")),
+        ("Model version", _value(record, "model_version")),
+        ("Task variant", _value(record, "task_variant")),
+        ("Noise stage", _value(record, "noise_stage")),
+        ("Ecosystem", _value(record, "ecosystem")),
+        ("Model variant", _value(record, "model_variant")),
+        ("Unresolved hint", _value(record, "unresolved_hint")),
+        ("Techniques", _value(record, "techniques")),
+        ("Suggested subfolder", _value(record, "sort_subfolder")),
+        ("Tensor-key format", _value(record, "format", "unknown")),
+        ("Tensor records", _value(record, "total_tensors", "0")),
+        ("Header bytes", _value(record, "header_bytes", "0")),
+        ("Payload bytes", _value(record, "payload_bytes", "0")),
+        ("File bytes", _value(record, "file_size", "0")),
+        ("Structure says", _value(record, "structure_arch")),
+        ("Metadata says", _value(record, "metadata_arch")),
+        ("Filename says", _value(record, "name_arch")),
+    )
+    width = max(len(label) for label, _ in rows)
+    for label, value in rows:
+        print(f"{label:<{width}} : {value}")
+    if record.get("error"):
+        print("\nERROR")
+        print(textwrap.fill(str(record["error"]), width=78, subsequent_indent="  "))
+    evidence_json = str(record.get("evidence_json", "") or "")
+    if evidence_json:
+        try:
+            evidence = json.loads(evidence_json)
+        except json.JSONDecodeError:
+            evidence = []
+        if evidence:
+            print("\nEvidence")
+            for item in evidence:
+                message = str(item.get("message", "") or "").strip()
+                if message:
+                    print(textwrap.fill(message, width=76, initial_indent="  - ", subsequent_indent="    "))
+
+
+def run(inputs: Sequence[str], *, follow_symlinks: bool = False, json_output: bool = False, hash_content: bool = False) -> int:
+    candidates = []
+    seen = set()
+    for raw in inputs:
+        for candidate in expand_arg(os.path.expanduser(str(raw))):
+            marker = str(candidate.absolute())
+            if marker not in seen:
+                seen.add(marker)
+                candidates.append(candidate)
+    if not candidates:
+        print("No files matched the supplied input.", file=sys.stderr)
+        return 1
+    records = [
+        inspect_one_file(candidate, follow_symlinks=follow_symlinks, include_content_hash=hash_content)
+        for candidate in candidates
+    ]
+    if json_output:
+        print(json.dumps(records, indent=2, ensure_ascii=False))
+    else:
+        for record in records:
+            print_record(record)
+        counts = {}
+        for record in records:
+            status = str(record.get("status", "unknown") or "unknown")
+            counts[status] = counts.get(status, 0) + 1
+        rendered = ", ".join(f"{name}={count}" for name, count in sorted(counts.items()))
+        print(f"\nSmoke inspection complete: files={len(records)}; {rendered}")
+        print("No CSV was written and no files were moved.")
+    return 1 if any(record.get("status") == "error" for record in records) else 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Read-only smoke inspection of LoRA safetensors headers.")
+    parser.add_argument("inputs", nargs="+", help="safetensors file, folder, or glob")
+    parser.add_argument("--follow-symlinks", action="store_true")
+    parser.add_argument("--json", action="store_true")
+    parser.add_argument("--hash-content", action="store_true")
+    return parser
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    args = build_parser().parse_args(list(argv) if argv is not None else None)
+    return run(
+        args.inputs,
+        follow_symlinks=args.follow_symlinks,
+        json_output=args.json,
+        hash_content=args.hash_content,
+    )
diff --git a/src/lora_header_inspector/transactions.py b/src/lora_header_inspector/transactions.py
new file mode 100644
index 0000000000000000000000000000000000000000..ca615e69ac8b4a3c5fa566cee28783141b529f99
--- /dev/null
+++ b/src/lora_header_inspector/transactions.py
@@ -0,0 +1,2223 @@
+"""Crash-aware move, hard-link, quarantine, recovery, and undo operations."""
+
+from __future__ import annotations
+
+import errno
+import json
+import os
+import shutil
+import tempfile
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Mapping, MutableMapping, Optional, Sequence, Set, Tuple
+
+from .fingerprints import (
+    HashCache,
+    file_identity,
+    full_file_sha256,
+    identity_matches,
+    same_inode,
+    verify_record_fingerprint,
+)
+from .paths import (
+    absolute_without_resolving,
+    normal_path_key,
+    verify_path_safety_snapshot,
+)
+from .schema import (
+    MANIFEST_SCHEMA_VERSION,
+    manifest_header,
+    undo_header,
+    write_json_atomic,
+    write_json_exclusive,
+)
+from .sidecars import verify_sidecar_snapshot
+from .version import (
+    MANIFEST_SCHEMA_NAME,
+    UNDO_SCHEMA_NAME,
+    UNDO_SCHEMA_VERSION,
+)
+
+COPY_CHUNK_BYTES = 8 * 1024 * 1024
+
+
+def _utc_stamp() -> str:
+    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
+
+
+def _fsync_directory(path: Path) -> None:
+    if os.name == "nt":
+        return
+    flags = getattr(os, "O_DIRECTORY", 0) | os.O_RDONLY
+    try:
+        descriptor = os.open(str(path), flags)
+    except OSError:
+        return
+    try:
+        os.fsync(descriptor)
+    except OSError:
+        pass
+    finally:
+        os.close(descriptor)
+
+
+def _copy_to_temp(
+    source: Path,
+    destination_parent: Path,
+    on_staged: Optional[Callable[[Path], None]] = None,
+) -> Path:
+    """Copy ``source`` into a uniquely named, fsynced staging file."""
+    destination_parent.mkdir(parents=True, exist_ok=True)
+    descriptor, temp_name = tempfile.mkstemp(
+        prefix=".lora-copy-", suffix=".tmp", dir=str(destination_parent)
+    )
+    temp_path = Path(temp_name)
+    try:
+        if on_staged is not None:
+            on_staged(temp_path)
+        with source.open("rb", buffering=0) as src, os.fdopen(
+            descriptor, "wb", buffering=0
+        ) as dst:
+            while True:
+                chunk = src.read(COPY_CHUNK_BYTES)
+                if not chunk:
+                    break
+                dst.write(chunk)
+            dst.flush()
+            os.fsync(dst.fileno())
+        shutil.copystat(str(source), str(temp_path), follow_symlinks=False)
+        return temp_path
+    except Exception:
+        try:
+            os.close(descriptor)
+        except OSError:
+            pass
+        try:
+            temp_path.unlink()
+        except OSError:
+            pass
+        raise
+
+
+def _hardlink_unavailable(exc: OSError) -> bool:
+    unavailable = {
+        errno.EXDEV,
+        errno.EPERM,
+        errno.EACCES,
+        getattr(errno, "EOPNOTSUPP", errno.EPERM),
+        getattr(errno, "ENOTSUP", errno.EPERM),
+        getattr(errno, "ENOSYS", errno.EPERM),
+    }
+    return exc.errno in unavailable
+
+
+def _matches_stable_identity(path: Path, expected: Mapping[str, Any]) -> bool:
+    """Compare identity fields that are not changed merely by adding a hard link."""
+    try:
+        current = file_identity(path)
+        return (
+            current.device == int(expected["device"])
+            and current.inode == int(expected["inode"])
+            and current.size == int(expected["size"])
+            and current.mtime_ns == int(expected["mtime_ns"])
+        )
+    except (OSError, ValueError, TypeError, KeyError):
+        return False
+
+
+def _publish_staging_no_replace(
+    staging: Path,
+    destination: Path,
+    on_destination_created: Optional[Callable[[Mapping[str, Any]], None]] = None,
+) -> str:
+    """Publish a verified staging file without ever replacing an existing path.
+
+    Hard-link publication is atomic and invisible until complete. On a filesystem
+    without hard links, the final path is created with ``O_EXCL`` and populated
+    through the descriptor that won that exclusive creation. That fallback may make
+    a partial final file visible during the second copy, but it cannot overwrite an
+    unrelated file and the journal can safely remove it after an interruption.
+    """
+    try:
+        os.link(str(staging), str(destination), follow_symlinks=False)
+    except OSError as exc:
+        if exc.errno == errno.EEXIST:
+            raise FileExistsError("destination already exists: %s" % destination)
+        if not _hardlink_unavailable(exc):
+            raise
+
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        descriptor = os.open(str(destination), flags, 0o600)
+        owned = os.fstat(descriptor)
+        created_identity = {
+            "device": str(owned.st_dev),
+            "inode": str(owned.st_ino),
+            "size": str(owned.st_size),
+            "mtime_ns": str(owned.st_mtime_ns),
+        }
+        try:
+            if on_destination_created is not None:
+                on_destination_created(created_identity)
+            with staging.open("rb", buffering=0) as src, os.fdopen(
+                descriptor, "wb", buffering=0
+            ) as dst:
+                descriptor = -1
+                while True:
+                    chunk = src.read(COPY_CHUNK_BYTES)
+                    if not chunk:
+                        break
+                    dst.write(chunk)
+                dst.flush()
+                os.fsync(dst.fileno())
+            shutil.copystat(str(staging), str(destination), follow_symlinks=False)
+            _fsync_directory(destination.parent)
+        except Exception:
+            if descriptor >= 0:
+                try:
+                    os.close(descriptor)
+                except OSError:
+                    pass
+            try:
+                if destination.exists() and not destination.is_symlink():
+                    current = destination.stat()
+                    if (current.st_dev, current.st_ino) == (owned.st_dev, owned.st_ino):
+                        destination.unlink()
+                        _fsync_directory(destination.parent)
+            except OSError:
+                pass
+            raise
+        return "copy-verify-exclusive-finalize-unlink"
+    else:
+        staging.unlink()
+        _fsync_directory(destination.parent)
+        return "copy-verify-link-publish-unlink"
+
+
+def safe_move(
+    source: Path,
+    destination: Path,
+    expected_sha256: str = "",
+    *,
+    on_staged: Optional[Callable[[Path], None]] = None,
+    on_destination_created: Optional[Callable[[Mapping[str, Any]], None]] = None,
+    on_published: Optional[Callable[[Mapping[str, Any]], None]] = None,
+) -> Dict[str, Any]:
+    """Move one regular file without overwriting and with recoverable phases.
+
+    On a filesystem that supports hard links, a same-device move is published by
+    linking the source to the destination and then unlinking the old name.  This
+    gives us a genuine no-overwrite operation.  Cross-device moves are copied to
+    a journalled staging file, fully hashed, then published without replacement
+    before the source is removed.
+    """
+    source = absolute_without_resolving(source)
+    destination = absolute_without_resolving(destination)
+    if normal_path_key(source) == normal_path_key(destination):
+        raise ValueError("source and destination are the same path")
+    if source.is_symlink() or not source.is_file():
+        raise ValueError("source missing or is a symlink: %s" % source)
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError("destination already exists: %s" % destination)
+
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    source_parent = source.parent
+    destination_parent = destination.parent
+    before = file_identity(source)
+
+    # Fast, same-filesystem no-overwrite publication.
+    try:
+        os.link(str(source), str(destination), follow_symlinks=False)
+    except OSError as exc:
+        if exc.errno == errno.EEXIST:
+            raise FileExistsError("destination already exists: %s" % destination)
+        if not _hardlink_unavailable(exc):
+            raise
+    else:
+        destination_identity = file_identity(destination)
+        if destination_identity.device != before.device or destination_identity.inode != before.inode:
+            raise RuntimeError(
+                "new destination link does not reference the inspected source inode"
+            )
+        if not _matches_stable_identity(source, before.to_dict()):
+            # Do not unlink either name when another process changed the source path
+            # during publication. The extra destination link preserves the inspected
+            # inode for manual recovery rather than risking data loss.
+            raise RuntimeError("source identity changed during same-filesystem publication")
+        result: Dict[str, Any] = {
+            "method": "link-unlink",
+            "sha256": expected_sha256,
+            "size": str(before.size),
+            "source_identity": before.to_dict(),
+            "destination_identity": destination_identity.to_dict(),
+        }
+        try:
+            if on_published is not None:
+                on_published(result)
+            source.unlink()
+            _fsync_directory(source_parent)
+            if destination_parent != source_parent:
+                _fsync_directory(destination_parent)
+        except Exception:
+            try:
+                if destination.exists() and not destination.is_symlink() and same_inode(
+                    source, destination
+                ):
+                    destination.unlink()
+                    _fsync_directory(destination_parent)
+            except OSError:
+                pass
+            raise
+        return result
+
+    # Cross-device or hard-link-incapable filesystem.
+    source_digest = expected_sha256 or full_file_sha256(source)
+    temp_path = _copy_to_temp(source, destination_parent, on_staged=on_staged)
+    published = False
+    method = ""
+    try:
+        temp_identity = file_identity(temp_path)
+        if temp_identity.size != before.size:
+            raise IOError(
+                "staged copy size mismatch: source=%d temporary=%d"
+                % (before.size, temp_identity.size)
+            )
+        temp_digest = full_file_sha256(temp_path)
+        if temp_digest != source_digest:
+            raise IOError("staged copy SHA-256 mismatch")
+        if destination.exists() or destination.is_symlink():
+            raise FileExistsError("destination appeared during copy: %s" % destination)
+        method = _publish_staging_no_replace(
+            temp_path,
+            destination,
+            on_destination_created=on_destination_created,
+        )
+        published = True
+        destination_identity = file_identity(destination)
+        if destination_identity.size != before.size:
+            raise IOError(
+                "published destination size mismatch: source=%d destination=%d"
+                % (before.size, destination_identity.size)
+            )
+        destination_digest = full_file_sha256(destination)
+        if destination_digest != source_digest:
+            raise IOError("published destination SHA-256 mismatch")
+        result = {
+            "method": method,
+            "sha256": source_digest,
+            "size": str(before.size),
+            "source_identity": before.to_dict(),
+            "destination_identity": destination_identity.to_dict(),
+            "staging_path": str(temp_path),
+        }
+        if on_published is not None:
+            on_published(result)
+        _fsync_directory(destination_parent)
+        try:
+            source.unlink()
+            _fsync_directory(source_parent)
+        except Exception:
+            try:
+                if destination.exists() and not destination.is_symlink():
+                    destination.unlink()
+                    _fsync_directory(destination_parent)
+            except Exception as rollback_exc:
+                raise RuntimeError(
+                    "source removal failed after verified copy; destination rollback also failed: %s"
+                    % rollback_exc
+                )
+            raise
+        return result
+    except Exception:
+        if published:
+            try:
+                if destination.exists() and not destination.is_symlink():
+                    destination.unlink()
+                    _fsync_directory(destination_parent)
+            except OSError:
+                pass
+        raise
+    finally:
+        if temp_path.exists():
+            try:
+                temp_path.unlink()
+                _fsync_directory(temp_path.parent)
+            except OSError:
+                pass
+
+
+def atomic_hardlink(source: Path, target: Path) -> None:
+    if source.is_symlink() or not source.is_file():
+        raise ValueError(f"hard-link source is not a regular file: {source}")
+    if target.exists() or target.is_symlink():
+        raise FileExistsError(f"hard-link target already exists: {target}")
+    target.parent.mkdir(parents=True, exist_ok=True)
+    os.link(str(source), str(target), follow_symlinks=False)
+    _fsync_directory(target.parent)
+
+
+def _unique_sibling(path: Path, marker: str) -> Path:
+    """Return a non-existing sibling path without creating it."""
+    for _ in range(100):
+        candidate = path.with_name(
+            f".{path.name}.{marker}.{uuid.uuid4().hex}.tmp"
+        )
+        if not candidate.exists() and not candidate.is_symlink():
+            return candidate
+    raise RuntimeError(f"could not allocate a private sibling path for {path}")
+
+
+def _restore_backup(path: Path, backup: Path, digest: str = "") -> List[str]:
+    """Restore ``backup`` to ``path`` without overwriting an unrelated file."""
+    errors: List[str] = []
+    try:
+        if backup.is_symlink():
+            return [f"backup path became a symlink: {backup}"]
+        if not backup.exists():
+            return []
+        if path.exists() or path.is_symlink():
+            return [f"cannot restore backup because destination is occupied: {path}"]
+        safe_move(backup, path, expected_sha256=digest)
+    except Exception as exc:
+        errors.append(f"could not restore {backup} -> {path}: {exc}")
+    return errors
+
+
+def atomic_relink(
+    path: Path,
+    canonical: Path,
+    *,
+    expected_identity: Optional[Mapping[str, Any]] = None,
+    expected_sha256: str = "",
+) -> None:
+    """Replace an exact duplicate by a hard link without overwriting a race.
+
+    The old inode is first moved to a private sibling backup using ``safe_move``.
+    The canonical link is then created at the now-vacant public path with
+    ``O_EXCL``-equivalent hard-link semantics.  A concurrent creator therefore
+    causes a clean failure rather than being overwritten, and the private backup
+    is restored whenever the public path is still available.
+    """
+    path = absolute_without_resolving(path)
+    canonical = absolute_without_resolving(canonical)
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"relink target is not a regular file: {path}")
+    if canonical.is_symlink() or not canonical.is_file():
+        raise ValueError(f"canonical path is not a regular file: {canonical}")
+    if expected_identity and not _matches_stable_identity(path, expected_identity):
+        raise ValueError(f"relink target changed before replacement: {path}")
+    digest = expected_sha256 or full_file_sha256(path)
+    if full_file_sha256(canonical) != digest:
+        raise ValueError("relink target and canonical path no longer have identical content")
+    if same_inode(path, canonical):
+        return
+
+    backup = _unique_sibling(path, "relink-backup")
+    safe_move(path, backup, expected_sha256=digest)
+    try:
+        atomic_hardlink(canonical, path)
+        if not same_inode(path, canonical):
+            raise RuntimeError("new relink path does not reference the canonical inode")
+        backup.unlink()
+        _fsync_directory(backup.parent)
+    except Exception as exc:
+        restore_errors: List[str] = []
+        try:
+            if path.exists() and not path.is_symlink() and same_inode(path, canonical):
+                path.unlink()
+                _fsync_directory(path.parent)
+        except Exception as remove_exc:
+            restore_errors.append(f"could not remove failed relink target {path}: {remove_exc}")
+        restore_errors.extend(_restore_backup(path, backup, digest))
+        if restore_errors:
+            raise RuntimeError(
+                f"relink failed: {exc}; rollback errors: {' | '.join(restore_errors)}"
+            ) from exc
+        raise
+
+
+def break_hardlink(
+    path: Path,
+    *,
+    canonical: Optional[Path] = None,
+    expected_sha256: str = "",
+) -> None:
+    """Replace a linked path by an independent byte-identical inode safely.
+
+    The current link is moved to a private backup before a verified copy is
+    published at the public name. No unrelated file is overwritten if another
+    process races to claim the path.
+    """
+    path = absolute_without_resolving(path)
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"cannot break link for non-regular file: {path}")
+    if canonical is not None:
+        canonical = absolute_without_resolving(canonical)
+        if canonical.is_symlink() or not canonical.is_file():
+            raise ValueError(f"canonical path is unavailable: {canonical}")
+        if not same_inode(path, canonical):
+            raise ValueError(f"path no longer shares the canonical inode: {path}")
+
+    digest = expected_sha256 or full_file_sha256(path)
+    staging = _copy_to_temp(path, path.parent)
+    if full_file_sha256(staging) != digest:
+        staging.unlink(missing_ok=True)
+        raise IOError("independent-copy staging hash mismatch")
+    backup = _unique_sibling(path, "breaklink-backup")
+    safe_move(path, backup, expected_sha256=digest)
+    published = False
+    try:
+        _publish_staging_no_replace(staging, path)
+        published = True
+        if full_file_sha256(path) != digest:
+            raise IOError("independent hard-link copy hash mismatch")
+        if canonical is not None and same_inode(path, canonical):
+            raise RuntimeError("hard link was not broken")
+        backup.unlink()
+        _fsync_directory(backup.parent)
+    except Exception as exc:
+        errors: List[str] = []
+        try:
+            if published and path.exists() and not path.is_symlink():
+                path.unlink()
+                _fsync_directory(path.parent)
+        except Exception as remove_exc:
+            errors.append(f"could not remove independent copy {path}: {remove_exc}")
+        errors.extend(_restore_backup(path, backup, digest))
+        if errors:
+            raise RuntimeError(
+                f"could not break hard link: {exc}; rollback errors: {' | '.join(errors)}"
+            ) from exc
+        raise
+    finally:
+        try:
+            staging.unlink()
+        except OSError:
+            pass
+
+
+def _journaled_relink_step(
+    step: MutableMapping[str, Any],
+    persist: Callable[[], None],
+) -> None:
+    """Execute one duplicate relink while persisting every recoverable phase."""
+    path = Path(str(step["path"]))
+    canonical = Path(str(step["canonical"]))
+    digest = str(step.get("sha256", "") or "")
+    expected_identity = step.get("before_identity", {})
+    if not identity_matches(path, expected_identity):
+        raise ValueError(f"duplicate path changed before relink: {path}")
+    if not canonical.is_file() or canonical.is_symlink():
+        raise ValueError(f"canonical path is unavailable: {canonical}")
+    if digest:
+        if full_file_sha256(path) != digest:
+            raise ValueError(f"duplicate path content changed before relink: {path}")
+        if full_file_sha256(canonical) != digest:
+            raise ValueError("canonical duplicate content changed before relink")
+    if same_inode(path, canonical):
+        step["status"] = "done"
+        step["already_linked"] = True
+        persist()
+        return
+
+    backup = Path(str(step.get("backup_path", "") or ""))
+    if not str(step.get("backup_path", "") or ""):
+        backup = _unique_sibling(path, "relink-backup")
+        step["backup_path"] = str(backup)
+    backup_move = step.get("backup_move")
+    if not isinstance(backup_move, MutableMapping):
+        backup_move = {
+            "type": "move",
+            "from": str(path),
+            "to": str(backup),
+            "status": "pending",
+            "method": "",
+            "sha256": digest,
+            "size": str(file_identity(path).size),
+            "source_identity": file_identity(path).to_dict(),
+            "destination_identity": {},
+            "staging_path": "",
+        }
+        step["backup_move"] = backup_move
+    step["status"] = "backup_planned"
+    persist()
+
+    def staged(staging_path: Path) -> None:
+        backup_move["staging_path"] = str(staging_path)
+        backup_move["status"] = "staging"
+        step["status"] = "backup_staging"
+        persist()
+
+    def destination_created(identity: Mapping[str, Any]) -> None:
+        backup_move["destination_identity"] = dict(identity)
+        backup_move["status"] = "publishing"
+        step["status"] = "backup_publishing"
+        persist()
+
+    def published(result: Mapping[str, Any]) -> None:
+        backup_move.update(result)
+        backup_move["status"] = "published"
+        step["status"] = "backup_published"
+        persist()
+
+    result = safe_move(
+        path,
+        backup,
+        expected_sha256=digest,
+        on_staged=staged,
+        on_destination_created=destination_created,
+        on_published=published,
+    )
+    backup_move.update(result)
+    backup_move["status"] = "done"
+    step["status"] = "backup_moved"
+    persist()
+
+    atomic_hardlink(canonical, path)
+    step["replacement_identity"] = file_identity(path).to_dict()
+    step["status"] = "linked"
+    persist()
+    if not same_inode(path, canonical):
+        raise RuntimeError("relinked path does not share the canonical inode")
+
+    backup.unlink()
+    _fsync_directory(backup.parent)
+    step["backup_removed"] = True
+    step["status"] = "done"
+    persist()
+
+
+def _rollback_relink_step(step: MutableMapping[str, Any]) -> List[str]:
+    """Restore one journaled relink step to an independent public path."""
+    errors: List[str] = []
+    path = Path(str(step.get("path", "")))
+    canonical = Path(str(step.get("canonical", "")))
+    digest = str(step.get("sha256", "") or "")
+    backup_text = str(step.get("backup_path", "") or "")
+    backup = Path(backup_text) if backup_text else None
+
+    try:
+        path_is_link = (
+            path.exists()
+            and not path.is_symlink()
+            and canonical.exists()
+            and not canonical.is_symlink()
+            and same_inode(path, canonical)
+        )
+        backup_exists = bool(backup and backup.exists() and not backup.is_symlink())
+        if backup is not None and backup.is_symlink():
+            errors.append(f"relink backup became a symlink: {backup}")
+            return errors
+
+        if backup_exists:
+            if path_is_link:
+                path.unlink()
+                _fsync_directory(path.parent)
+            elif path.exists() or path.is_symlink():
+                before_identity = step.get("before_identity", {})
+                if isinstance(before_identity, Mapping) and identity_matches(path, before_identity):
+                    # The original path is already restored. The private backup is
+                    # another link/copy of the same original and may be removed.
+                    if _same_regular_content(path, backup):
+                        backup.unlink()
+                        _fsync_directory(backup.parent)
+                        step["status"] = "rolled_back"
+                        return errors
+                errors.append(f"cannot restore relink backup because path is occupied: {path}")
+                return errors
+            errors.extend(_restore_backup(path, backup, digest))
+            if not errors:
+                step["status"] = "rolled_back"
+            return errors
+
+        if path_is_link:
+            # The private backup was already removed. Re-create an independent
+            # byte-identical inode, which is the strongest reversible state left.
+            break_hardlink(path, canonical=canonical, expected_sha256=digest)
+            step["status"] = "rolled_back"
+            return errors
+
+        before_identity = step.get("before_identity", {})
+        if path.exists() and not path.is_symlink() and isinstance(before_identity, Mapping):
+            if identity_matches(path, before_identity):
+                step["status"] = "rolled_back"
+                return errors
+        errors.append(f"cannot determine a safe relink rollback for {path}")
+    except Exception as exc:
+        errors.append(f"could not roll back relink {path}: {exc}")
+    return errors
+
+
+def _journaled_break_link_step(
+    step: MutableMapping[str, Any],
+    persist: Callable[[], None],
+) -> None:
+    """Break one canonical hard link into an independent copy with a journal."""
+    path = Path(str(step["path"]))
+    canonical = Path(str(step["canonical"]))
+    digest = str(step.get("sha256", "") or "")
+    expected_identity = step.get("linked_identity", {})
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"hard-link path is unavailable: {path}")
+    if canonical.is_symlink() or not canonical.is_file():
+        raise ValueError(f"canonical path is unavailable: {canonical}")
+    if expected_identity and not _matches_stable_identity(path, expected_identity):
+        raise ValueError(f"hard-link path changed before undo: {path}")
+    if not same_inode(path, canonical):
+        raise ValueError(f"hard-link path no longer shares the canonical inode: {path}")
+    if digest and full_file_sha256(path) != digest:
+        raise ValueError(f"hard-link content changed before undo: {path}")
+
+    staging_text = str(step.get("staging_path", "") or "")
+    if staging_text:
+        staging = Path(staging_text)
+    else:
+        def staged_created(temp_path: Path) -> None:
+            step["staging_path"] = str(temp_path)
+            step["status"] = "copy_staging"
+            persist()
+
+        staging = _copy_to_temp(path, path.parent, on_staged=staged_created)
+        if digest and full_file_sha256(staging) != digest:
+            raise IOError("independent-copy staging SHA-256 mismatch")
+        step["staging_identity"] = file_identity(staging).to_dict()
+        step["status"] = "copy_staged"
+        persist()
+
+    backup_text = str(step.get("backup_path", "") or "")
+    backup = Path(backup_text) if backup_text else _unique_sibling(path, "undo-break-backup")
+    if not backup_text:
+        step["backup_path"] = str(backup)
+
+    backup_move = step.get("backup_move")
+    if not isinstance(backup_move, MutableMapping):
+        backup_move = {
+            "type": "move",
+            "from": str(path),
+            "to": str(backup),
+            "status": "pending",
+            "method": "",
+            "sha256": digest,
+            "size": str(file_identity(path).size),
+            "source_identity": file_identity(path).to_dict(),
+            "destination_identity": {},
+            "staging_path": "",
+        }
+        step["backup_move"] = backup_move
+    step["status"] = "backup_planned"
+    persist()
+
+    def backup_staged(temp_path: Path) -> None:
+        backup_move["staging_path"] = str(temp_path)
+        backup_move["status"] = "staging"
+        step["status"] = "backup_staging"
+        persist()
+
+    def backup_destination_created(identity: Mapping[str, Any]) -> None:
+        backup_move["destination_identity"] = dict(identity)
+        backup_move["status"] = "publishing"
+        step["status"] = "backup_publishing"
+        persist()
+
+    def backup_published(result: Mapping[str, Any]) -> None:
+        backup_move.update(result)
+        backup_move["status"] = "published"
+        step["status"] = "backup_published"
+        persist()
+
+    backup_result = safe_move(
+        path,
+        backup,
+        expected_sha256=digest,
+        on_staged=backup_staged,
+        on_destination_created=backup_destination_created,
+        on_published=backup_published,
+    )
+    backup_move.update(backup_result)
+    backup_move["status"] = "done"
+    step["status"] = "backup_moved"
+    persist()
+
+    def independent_destination_created(identity: Mapping[str, Any]) -> None:
+        step["replacement_identity"] = dict(identity)
+        step["status"] = "copy_publishing"
+        persist()
+
+    publish_method = _publish_staging_no_replace(
+        staging,
+        path,
+        on_destination_created=independent_destination_created,
+    )
+    step["publish_method"] = publish_method
+    step["replacement_identity"] = file_identity(path).to_dict()
+    step["staging_path"] = ""
+    step["status"] = "independent_published"
+    persist()
+    if digest and full_file_sha256(path) != digest:
+        raise IOError("independent hard-link copy SHA-256 mismatch")
+    if same_inode(path, canonical):
+        raise RuntimeError("hard link was not broken")
+
+    backup.unlink()
+    _fsync_directory(backup.parent)
+    step["backup_removed"] = True
+    step["status"] = "done"
+    persist()
+
+
+def _rollback_break_link_step(step: MutableMapping[str, Any]) -> List[str]:
+    """Restore an interrupted hard-link break to the original linked state."""
+    errors: List[str] = []
+    path = Path(str(step.get("path", "")))
+    canonical = Path(str(step.get("canonical", "")))
+    digest = str(step.get("sha256", "") or "")
+    backup_text = str(step.get("backup_path", "") or "")
+    backup = Path(backup_text) if backup_text else None
+
+    try:
+        if canonical.is_symlink() or not canonical.is_file():
+            errors.append(f"canonical path is unavailable: {canonical}")
+            return errors
+        path_exists = path.exists() and not path.is_symlink()
+        path_is_link = path_exists and same_inode(path, canonical)
+        backup_exists = bool(backup and backup.exists() and not backup.is_symlink())
+        if backup is not None and backup.is_symlink():
+            errors.append(f"undo backup became a symlink: {backup}")
+            return errors
+
+        if backup_exists:
+            if path_is_link:
+                # The apply state already exists. The backup is another link to the
+                # same inode and can be discarded after a content check.
+                if not _same_regular_content(path, backup):
+                    errors.append(f"undo backup content disagrees with linked path: {backup}")
+                    return errors
+                backup.unlink()
+                _fsync_directory(backup.parent)
+            elif path_exists:
+                replacement_identity = step.get("replacement_identity", {})
+                owned = (
+                    isinstance(replacement_identity, Mapping)
+                    and bool(replacement_identity)
+                    and identity_matches(path, replacement_identity)
+                )
+                if not owned and digest:
+                    owned = full_file_sha256(path) == digest
+                if not owned:
+                    errors.append(f"public path was replaced during undo: {path}")
+                    return errors
+                path.unlink()
+                _fsync_directory(path.parent)
+                errors.extend(_restore_backup(path, backup, digest))
+            else:
+                errors.extend(_restore_backup(path, backup, digest))
+        elif path_is_link:
+            pass
+        elif path_exists:
+            if digest and full_file_sha256(path) != digest:
+                errors.append(f"independent path content changed during undo: {path}")
+                return errors
+            atomic_relink(
+                path,
+                canonical,
+                expected_identity=file_identity(path).to_dict(),
+                expected_sha256=digest,
+            )
+        else:
+            errors.append(f"neither linked path nor undo backup exists: {path}")
+            return errors
+
+        if path.exists() and not same_inode(path, canonical):
+            errors.append(f"rollback did not restore canonical hard link: {path}")
+        if not errors:
+            step["status"] = "rolled_back"
+    except Exception as exc:
+        errors.append(f"could not roll back hard-link break {path}: {exc}")
+    finally:
+        staging_text = str(step.get("staging_path", "") or "")
+        if staging_text:
+            staging = Path(staging_text)
+            try:
+                if staging.exists() and not staging.is_symlink():
+                    staging.unlink()
+                    _fsync_directory(staging.parent)
+                elif staging.is_symlink():
+                    errors.append(f"undo staging path became a symlink: {staging}")
+            except Exception as exc:
+                errors.append(f"could not remove undo staging file {staging}: {exc}")
+    return errors
+
+
+def _preflight_transfers(transfers: Sequence[Tuple[Path, Path]]) -> Tuple[bool, str]:
+    sources: Set[str] = set()
+    destinations: Set[str] = set()
+    for source, destination in transfers:
+        source_key = normal_path_key(source)
+        destination_key = normal_path_key(destination)
+        if source_key in sources:
+            return False, f"duplicate source in transaction: {source}"
+        if destination_key in destinations:
+            return False, f"duplicate destination in transaction: {destination}"
+        sources.add(source_key)
+        destinations.add(destination_key)
+        if source.is_symlink() or not source.is_file():
+            return False, f"source missing or is a symlink: {source}"
+        if destination.exists() or destination.is_symlink():
+            return False, f"destination already exists: {destination}"
+    return True, ""
+
+
+def _current_regular_transfers(record: Mapping[str, str]) -> Tuple[List[Tuple[Path, Path]], str]:
+    source = Path(record["path"])
+    destination = Path(record["destination"])
+    valid, reason, sidecars = verify_sidecar_snapshot(
+        source,
+        record.get("sidecar_fingerprints_json", ""),
+        require_hash=True,
+    )
+    if not valid:
+        return [], reason
+    transfers = [(item, destination.parent / item.name) for item in sidecars]
+    transfers.append((source, destination))
+    return transfers, ""
+
+
+def _default_manifest_path(csv_path: Path) -> Path:
+    return csv_path.with_name(f"{csv_path.stem}_manifest_{_utc_stamp()}.json")
+
+
+def _new_manifest(
+    csv_path: Path,
+    base_dir: Path,
+    *,
+    allow_outside_base: bool,
+    allow_symlink_parents: bool,
+) -> Dict[str, Any]:
+    manifest = manifest_header("apply")
+    manifest.update(
+        manifest_id=str(uuid.uuid4()),
+        created_utc=datetime.now(timezone.utc).isoformat(),
+        updated_utc=datetime.now(timezone.utc).isoformat(),
+        status="in_progress",
+        base_dir=str(base_dir),
+        base_resolved=str(base_dir.resolve(strict=False)),
+        allow_outside_base=bool(allow_outside_base),
+        allow_symlink_parents=bool(allow_symlink_parents),
+        source_csv=str(csv_path),
+        operations=[],
+    )
+    return manifest
+
+
+def _create_manifest(manifest: MutableMapping[str, Any], path: Path) -> None:
+    """Create the first journal image without replacing a race winner."""
+    manifest["updated_utc"] = datetime.now(timezone.utc).isoformat()
+    write_json_exclusive(manifest, path)
+
+
+def _save_manifest(manifest: MutableMapping[str, Any], path: Path) -> None:
+    manifest["updated_utc"] = datetime.now(timezone.utc).isoformat()
+    write_json_atomic(manifest, path)
+
+
+def _protected_manifest_paths(plan: Sequence[Mapping[str, str]], csv_path: Path) -> Set[str]:
+    protected = {normal_path_key(csv_path)}
+    for record in plan:
+        text = str(record.get("_transfers", "") or "")
+        try:
+            parsed = json.loads(text) if text else []
+        except json.JSONDecodeError:
+            parsed = []
+        if isinstance(parsed, list):
+            for item in parsed:
+                if isinstance(item, (list, tuple)) and len(item) == 2:
+                    protected.add(normal_path_key(Path(str(item[0]))))
+                    protected.add(normal_path_key(Path(str(item[1]))))
+    return protected
+
+
+def _records_for_group(plan: Sequence[Mapping[str, str]], group_id: str) -> List[Mapping[str, str]]:
+    return [record for record in plan if record.get("collision_group") == group_id]
+
+
+def _verify_group_records(
+    records: Sequence[Mapping[str, str]], cache: HashCache, expected_sha256: str
+) -> Tuple[bool, str]:
+    for record in records:
+        source = Path(record.get("path", ""))
+        valid, reason = verify_record_fingerprint(record, source, cache=cache)
+        if not valid:
+            return False, f"{source}: {reason}"
+        if expected_sha256:
+            try:
+                digest = full_file_sha256(source, cache)
+            except Exception as exc:
+                return False, f"{source}: could not rehash duplicate member: {exc}"
+            if digest != expected_sha256:
+                return False, f"{source}: duplicate content changed after planning"
+        valid_sidecars, sidecar_reason, _ = verify_sidecar_snapshot(
+            source,
+            record.get("sidecar_fingerprints_json", ""),
+            require_hash=True,
+        )
+        if not valid_sidecars:
+            return False, f"{source}: {sidecar_reason}"
+    return True, ""
+
+
+def _same_regular_content(first: Path, second: Path) -> bool:
+    try:
+        if first.is_symlink() or second.is_symlink():
+            return False
+        if not first.is_file() or not second.is_file():
+            return False
+        if same_inode(first, second):
+            return True
+        if first.stat().st_size != second.stat().st_size:
+            return False
+        return full_file_sha256(first) == full_file_sha256(second)
+    except Exception:
+        return False
+
+
+def _remove_staging(step: MutableMapping[str, Any], errors: List[str]) -> None:
+    raw = str(step.get("staging_path", "") or "")
+    if not raw:
+        return
+    staging = Path(raw)
+    try:
+        if staging.exists() and not staging.is_symlink():
+            staging.unlink()
+            _fsync_directory(staging.parent)
+        elif staging.is_symlink():
+            errors.append("staging path became a symlink: %s" % staging)
+    except Exception as exc:
+        errors.append("could not remove staging file %s: %s" % (staging, exc))
+
+
+def _rollback_move_steps(
+    steps: Sequence[MutableMapping[str, Any]],
+) -> List[str]:
+    """Restore pre-operation names, including a process killed mid-step."""
+    errors: List[str] = []
+    for step in reversed(steps):
+        status = str(step.get("status", "pending") or "pending")
+        if status in {"rolled_back", "not_started"}:
+            _remove_staging(step, errors)
+            continue
+        source = Path(str(step.get("from", "")))
+        destination = Path(str(step.get("to", "")))
+        if not str(source) or not str(destination):
+            errors.append("move step is missing a source or destination")
+            continue
+        try:
+            source_exists = source.exists() and not source.is_symlink()
+            destination_exists = destination.exists() and not destination.is_symlink()
+            if source.is_symlink() or destination.is_symlink():
+                errors.append(
+                    "rollback refused a symlink path: %s -> %s" % (destination, source)
+                )
+                continue
+
+            if source_exists and destination_exists:
+                # The process may have published a no-overwrite link/copy but
+                # died before unlinking the old name or marking the step done.
+                recorded_destination = step.get("destination_identity", {})
+                owned_partial = (
+                    isinstance(recorded_destination, Mapping)
+                    and bool(recorded_destination)
+                    and identity_matches(destination, recorded_destination)
+                )
+                if not _same_regular_content(source, destination) and not owned_partial:
+                    errors.append(
+                        "both rollback paths exist with different content: %s and %s"
+                        % (source, destination)
+                    )
+                    continue
+                destination.unlink()
+                _fsync_directory(destination.parent)
+                step["status"] = "rolled_back"
+            elif not source_exists and destination_exists:
+                source.parent.mkdir(parents=True, exist_ok=True)
+                safe_move(
+                    destination,
+                    source,
+                    expected_sha256=str(step.get("sha256", "") or ""),
+                )
+                step["status"] = "rolled_back"
+            elif source_exists and not destination_exists:
+                # No published mutation remains.  A staging file may still do.
+                step["status"] = "rolled_back"
+            else:
+                errors.append(
+                    "neither rollback source nor original path exists: %s / %s"
+                    % (destination, source)
+                )
+                continue
+        except Exception as exc:
+            errors.append("%s -> %s: %s" % (destination, source, exc))
+        finally:
+            _remove_staging(step, errors)
+    return errors
+
+
+def _apply_move_operation(
+    record: MutableMapping[str, str],
+    operation: MutableMapping[str, Any],
+    manifest: MutableMapping[str, Any],
+    manifest_path: Path,
+    cache: HashCache,
+) -> Tuple[bool, List[str]]:
+    source = Path(record["path"])
+    valid, reason = verify_record_fingerprint(record, source, cache=cache)
+    if not valid:
+        record.update(move="False", action="skip_stale_or_unverified", reason=reason, verified="False")
+        operation.update(status="skipped", error=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    transfers, error = _current_regular_transfers(record)
+    if error:
+        record.update(move="False", action="skip_stale_sidecars", reason=error)
+        operation.update(status="skipped", error=error)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    ready, error = _preflight_transfers(transfers)
+    if not ready:
+        record.update(move="False", action="skip_preflight", reason=error)
+        operation.update(status="skipped", error=error)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+
+    operation["steps"] = [
+        {
+            "type": "move",
+            "from": str(src),
+            "to": str(dst),
+            "status": "pending",
+            "method": "",
+            "sha256": "",
+            "size": str(file_identity(src).size),
+            "source_identity": file_identity(src).to_dict(),
+            "destination_identity": {},
+            "staging_path": "",
+        }
+        for src, dst in transfers
+    ]
+    _save_manifest(manifest, manifest_path)
+    try:
+        for step in operation["steps"]:
+            def staged(path: Path, current=step) -> None:
+                current["staging_path"] = str(path)
+                current["status"] = "staging"
+                _save_manifest(manifest, manifest_path)
+
+            def published(result: Mapping[str, Any], current=step) -> None:
+                current.update(result)
+                current["status"] = "published"
+                _save_manifest(manifest, manifest_path)
+
+            def destination_created(identity: Mapping[str, Any], current=step) -> None:
+                current["destination_identity"] = dict(identity)
+                current["status"] = "publishing"
+                _save_manifest(manifest, manifest_path)
+
+            result = safe_move(
+                Path(step["from"]),
+                Path(step["to"]),
+                on_staged=staged,
+                on_destination_created=destination_created,
+                on_published=published,
+            )
+            step.update(status="done", **result)
+            _save_manifest(manifest, manifest_path)
+    except Exception as exc:
+        rollback_errors = _rollback_move_steps(operation["steps"])
+        operation.update(
+            status="rollback_error" if rollback_errors else "rolled_back",
+            error=str(exc),
+            rollback_errors=rollback_errors,
+        )
+        _save_manifest(manifest, manifest_path)
+        return False, rollback_errors
+
+    operation["status"] = "completed"
+    record.update(action="moved", reason="transaction completed", verified="True")
+    _save_manifest(manifest, manifest_path)
+    return True, []
+
+
+def _rollback_hardlink_steps(
+    steps: Sequence[MutableMapping[str, Any]],
+) -> List[str]:
+    """Undo hard-link steps, including a process killed before status persistence."""
+    errors: List[str] = []
+    for step in reversed(steps):
+        status = str(step.get("status", "pending") or "pending")
+        if status in {"rolled_back", "not_started"}:
+            continue
+        step_type = str(step.get("type", "") or "")
+        try:
+            if step_type == "hardlink-create":
+                source = Path(str(step.get("source", "")))
+                target = Path(str(step.get("target", "")))
+                if target.is_symlink():
+                    errors.append("hard-link target became a symlink: %s" % target)
+                    continue
+                if not target.exists():
+                    step["status"] = "rolled_back"
+                    continue
+                if not source.exists() or source.is_symlink():
+                    errors.append(
+                        "cannot remove created hard link because its source is unavailable: %s"
+                        % source
+                    )
+                    continue
+                if not same_inode(source, target):
+                    errors.append(
+                        "hard-link target no longer points to its recorded source: %s"
+                        % target
+                    )
+                    continue
+                target.unlink()
+                _fsync_directory(target.parent)
+                step["status"] = "rolled_back"
+
+            elif step_type == "hardlink-replace":
+                errors.extend(_rollback_relink_step(step))
+            else:
+                errors.append("unsupported hard-link journal step: %s" % step_type)
+        except Exception as exc:
+            errors.append("%s: %s" % (step, exc))
+    return errors
+
+
+def _apply_hardlink_operation(
+    record: MutableMapping[str, str],
+    group_records: Sequence[Mapping[str, str]],
+    spec: Mapping[str, Any],
+    operation: MutableMapping[str, Any],
+    manifest: MutableMapping[str, Any],
+    manifest_path: Path,
+    cache: HashCache,
+) -> Tuple[bool, List[str]]:
+    digest = str(spec.get("content_sha256", ""))
+    valid, reason = _verify_group_records(group_records, cache, digest)
+    if not valid:
+        record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+        operation.update(status="skipped", error=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+
+    canonical = Path(spec["canonical_path"])
+    if not canonical.is_file() or canonical.is_symlink():
+        reason = f"canonical path is unavailable: {canonical}"
+        operation.update(status="skipped", error=reason)
+        record.update(move="False", action="skip_preflight", reason=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    if digest and full_file_sha256(canonical, cache) != digest:
+        reason = "canonical duplicate content changed after planning"
+        operation.update(status="skipped", error=reason)
+        record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+
+    steps: List[Dict[str, Any]] = []
+    for item in spec.get("links", []):
+        source = Path(item["source"])
+        target = Path(item["target"])
+        if not identity_matches(source, item["source_identity"]):
+            reason = f"hard-link source changed after planning: {source}"
+            operation.update(status="skipped", error=reason)
+            record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+            _save_manifest(manifest, manifest_path)
+            return False, []
+        if target.exists() or target.is_symlink():
+            reason = f"hard-link target appeared after planning: {target}"
+            operation.update(status="skipped", error=reason)
+            record.update(move="False", action="skip_preflight", reason=reason)
+            _save_manifest(manifest, manifest_path)
+            return False, []
+        steps.append(
+            {
+                "type": "hardlink-create",
+                "source": str(source),
+                "target": str(target),
+                "status": "pending",
+                "sha256": item.get("source_sha256", ""),
+            }
+        )
+    for item in spec.get("replacements", []):
+        path = Path(item["path"])
+        if not identity_matches(path, item["source_identity"]):
+            reason = f"duplicate path changed after planning: {path}"
+            operation.update(status="skipped", error=reason)
+            record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+            _save_manifest(manifest, manifest_path)
+            return False, []
+        if digest and full_file_sha256(path, cache) != digest:
+            reason = f"duplicate path content changed after planning: {path}"
+            operation.update(status="skipped", error=reason)
+            record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+            _save_manifest(manifest, manifest_path)
+            return False, []
+        steps.append(
+            {
+                "type": "hardlink-replace",
+                "path": str(path),
+                "canonical": str(canonical),
+                "status": "pending",
+                "before_identity": item["source_identity"],
+                "sha256": digest,
+                "backup_path": "",
+                "backup_move": {},
+                "replacement_identity": {},
+                "backup_removed": False,
+            }
+        )
+
+    operation["steps"] = steps
+    _save_manifest(manifest, manifest_path)
+    try:
+        for step in steps:
+            if step["type"] == "hardlink-create":
+                atomic_hardlink(Path(step["source"]), Path(step["target"]))
+                step["target_identity"] = file_identity(Path(step["target"])).to_dict()
+                step["status"] = "done"
+                _save_manifest(manifest, manifest_path)
+            else:
+                _journaled_relink_step(
+                    step,
+                    lambda: _save_manifest(manifest, manifest_path),
+                )
+    except Exception as exc:
+        rollback_errors = _rollback_hardlink_steps(steps)
+        operation.update(
+            status="rollback_error" if rollback_errors else "rolled_back",
+            error=str(exc),
+            rollback_errors=rollback_errors,
+        )
+        _save_manifest(manifest, manifest_path)
+        return False, rollback_errors
+
+    operation["status"] = "completed"
+    record.update(action="hardlinked_duplicate_group", reason="duplicate group hard-linked", verified="True")
+    _save_manifest(manifest, manifest_path)
+    return True, []
+
+
+def _apply_quarantine_operation(
+    record: MutableMapping[str, str],
+    group_records: Sequence[Mapping[str, str]],
+    spec: Mapping[str, Any],
+    operation: MutableMapping[str, Any],
+    manifest: MutableMapping[str, Any],
+    manifest_path: Path,
+    cache: HashCache,
+    allow_path_breakage: bool,
+) -> Tuple[bool, List[str]]:
+    if not allow_path_breakage:
+        reason = "quarantine changes existing model paths; pass --allow-workflow-path-breakage"
+        operation.update(status="skipped", error=reason)
+        record.update(move="False", action="skip_path_breakage_not_acknowledged", reason=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    digest = str(spec.get("content_sha256", ""))
+    valid, reason = _verify_group_records(group_records, cache, digest)
+    if not valid:
+        operation.update(status="skipped", error=reason)
+        record.update(move="False", action="skip_stale_duplicate_group", reason=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    transfers = [(Path(one), Path(two)) for one, two in spec.get("transfers", [])]
+    ready, reason = _preflight_transfers(transfers)
+    if not ready:
+        operation.update(status="skipped", error=reason)
+        record.update(move="False", action="skip_preflight", reason=reason)
+        _save_manifest(manifest, manifest_path)
+        return False, []
+    operation["steps"] = [
+        {
+            "type": "move",
+            "from": str(src),
+            "to": str(dst),
+            "status": "pending",
+            "method": "",
+            "sha256": "",
+            "size": str(file_identity(src).size),
+            "source_identity": file_identity(src).to_dict(),
+            "destination_identity": {},
+            "staging_path": "",
+        }
+        for src, dst in transfers
+    ]
+    _save_manifest(manifest, manifest_path)
+    try:
+        for step in operation["steps"]:
+            def staged(path: Path, current=step) -> None:
+                current["staging_path"] = str(path)
+                current["status"] = "staging"
+                _save_manifest(manifest, manifest_path)
+
+            def published(result: Mapping[str, Any], current=step) -> None:
+                current.update(result)
+                current["status"] = "published"
+                _save_manifest(manifest, manifest_path)
+
+            def destination_created(identity: Mapping[str, Any], current=step) -> None:
+                current["destination_identity"] = dict(identity)
+                current["status"] = "publishing"
+                _save_manifest(manifest, manifest_path)
+
+            result = safe_move(
+                Path(step["from"]),
+                Path(step["to"]),
+                on_staged=staged,
+                on_destination_created=destination_created,
+                on_published=published,
+            )
+            step.update(status="done", **result)
+            _save_manifest(manifest, manifest_path)
+    except Exception as exc:
+        rollback_errors = _rollback_move_steps(operation["steps"])
+        operation.update(
+            status="rollback_error" if rollback_errors else "rolled_back",
+            error=str(exc),
+            rollback_errors=rollback_errors,
+        )
+        _save_manifest(manifest, manifest_path)
+        return False, rollback_errors
+    operation["status"] = "completed"
+    record.update(action="quarantined_duplicate_group", reason="duplicate group normalized and quarantined", verified="True")
+    _save_manifest(manifest, manifest_path)
+    return True, []
+
+
+def apply_plan(
+    plan: Sequence[MutableMapping[str, str]],
+    csv_path: Path,
+    base_dir: Path,
+    dry_run: bool = True,
+    allow_unverified: bool = False,
+    manifest_path: Optional[Path] = None,
+    allow_workflow_path_breakage: bool = False,
+    allow_outside_base: bool = False,
+    allow_symlink_parents: bool = False,
+) -> Dict[str, int]:
+    counts = {"moved": 0, "skipped": 0, "errors": 0, "rolled_back": 0}
+    if dry_run:
+        for record in plan:
+            source = Path(record.get("path", ""))
+            action = record.get("action", "unknown")
+            if action in {"move", "hardlink_duplicate_group", "quarantine_duplicate_group"} and str(record.get("move", "")).lower() == "true":
+                print(f"[DRY] {action:28s} {source} -> {record.get('destination', '')}")
+            else:
+                if action != "already_in_place":
+                    print(f"[SKIP] {action:28s} {source.name}  {record.get('reason', '')}")
+                counts["skipped"] += 1
+        print("\nDry run complete. No files were moved or relinked.")
+        return counts
+
+    base_dir = absolute_without_resolving(base_dir)
+    if base_dir.exists() or base_dir.is_symlink():
+        if not base_dir.is_dir():
+            print(f"ERROR: --base exists but is not a directory: {base_dir}")
+            counts["errors"] += 1
+            return counts
+    else:
+        # The explicit --apply flag and explicit --base value are the user's
+        # authorization to create the bucket root. Individual operation journals
+        # still cover every file mutation below it.
+        try:
+            base_dir.mkdir(parents=True, exist_ok=False)
+            _fsync_directory(base_dir.parent)
+        except Exception as exc:
+            print(f"ERROR: could not create --base directory {base_dir}: {exc}")
+            counts["errors"] += 1
+            return counts
+
+    manifest_path = absolute_without_resolving(manifest_path or _default_manifest_path(csv_path))
+    if normal_path_key(manifest_path) in _protected_manifest_paths(plan, csv_path):
+        print("ERROR: manifest path overlaps the CSV or a planned transfer")
+        counts["errors"] += 1
+        return counts
+    if manifest_path.exists() or manifest_path.is_symlink():
+        print(f"ERROR: manifest already exists and will not be overwritten: {manifest_path}")
+        counts["errors"] += 1
+        return counts
+
+    manifest = _new_manifest(
+        csv_path,
+        base_dir,
+        allow_outside_base=allow_outside_base,
+        allow_symlink_parents=allow_symlink_parents,
+    )
+    try:
+        _create_manifest(manifest, manifest_path)
+    except Exception as exc:
+        print(f"ERROR: could not create apply manifest: {exc}")
+        counts["errors"] += 1
+        return counts
+    cache = HashCache()
+
+    for record in plan:
+        action = record.get("action", "")
+        source = Path(record.get("path", ""))
+        if action not in {"move", "hardlink_duplicate_group", "quarantine_duplicate_group"} or str(record.get("move", "")).lower() != "true":
+            if action != "already_in_place":
+                print(f"[SKIP] {action:28s} {source.name}  {record.get('reason', '')}")
+            counts["skipped"] += 1
+            continue
+
+        operation: Dict[str, Any] = {
+            "operation_id": str(uuid.uuid4()),
+            "record_path": str(source),
+            "type": action,
+            "status": "pending",
+            "error": "",
+            "rollback_errors": [],
+            "steps": [],
+        }
+        manifest["operations"].append(operation)
+        _save_manifest(manifest, manifest_path)
+        print(f"[APPLY] {action:28s} {source}")
+
+        paths_ok, path_reason = verify_path_safety_snapshot(
+            record.get("path_safety_json", ""),
+            base=base_dir,
+            allow_outside=allow_outside_base,
+            allow_symlink_parents=allow_symlink_parents,
+        )
+        if not paths_ok:
+            record.update(
+                move="False",
+                action="skip_path_safety_changed",
+                reason=path_reason,
+                verified="False",
+            )
+            operation.update(status="skipped", error=path_reason)
+            _save_manifest(manifest, manifest_path)
+            print(f"       skipped: {path_reason}")
+            counts["skipped"] += 1
+            continue
+
+        if action == "move":
+            success, rollback_errors = _apply_move_operation(record, operation, manifest, manifest_path, cache)
+        else:
+            try:
+                spec = json.loads(record.get("_duplicate_spec", "{}") or "{}")
+            except json.JSONDecodeError as exc:
+                success, rollback_errors = False, [f"invalid duplicate spec: {exc}"]
+                operation.update(status="rollback_error", error=str(exc), rollback_errors=rollback_errors)
+                _save_manifest(manifest, manifest_path)
+            else:
+                group_records = _records_for_group(plan, record.get("collision_group", ""))
+                if action == "hardlink_duplicate_group":
+                    success, rollback_errors = _apply_hardlink_operation(
+                        record, group_records, spec, operation, manifest, manifest_path, cache
+                    )
+                else:
+                    success, rollback_errors = _apply_quarantine_operation(
+                        record,
+                        group_records,
+                        spec,
+                        operation,
+                        manifest,
+                        manifest_path,
+                        cache,
+                        allow_workflow_path_breakage,
+                    )
+
+        if success:
+            counts["moved"] += 1
+        elif rollback_errors:
+            counts["errors"] += 1
+        elif operation.get("status") == "rolled_back":
+            counts["rolled_back"] += 1
+        else:
+            counts["skipped"] += 1
+
+    if any(operation.get("status") in {"pending", "rollback_error"} for operation in manifest["operations"]):
+        manifest["status"] = "attention_required"
+    elif any(operation.get("status") == "rolled_back" for operation in manifest["operations"]):
+        manifest["status"] = "completed_with_rollbacks"
+    else:
+        manifest["status"] = "completed"
+    _save_manifest(manifest, manifest_path)
+    print(
+        "\nApply complete. "
+        f"completed={counts['moved']} skipped={counts['skipped']} "
+        f"rolled_back={counts['rolled_back']} errors={counts['errors']}"
+    )
+    print(f"Manifest: {manifest_path}")
+    return counts
+
+
+def _load_manifest(
+    path: Path,
+    *,
+    expected_types: Sequence[str] = ("apply",),
+) -> Dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        data = json.load(handle)
+    if not isinstance(data, dict):
+        raise ValueError("manifest root is not an object")
+    if str(data.get("schema_name", "")) != MANIFEST_SCHEMA_NAME:
+        raise ValueError(
+            "unrecognised manifest schema name %r" % data.get("schema_name")
+        )
+    if str(data.get("schema_version", "")) != MANIFEST_SCHEMA_VERSION:
+        raise ValueError(
+            "unsupported manifest schema %r; expected %s"
+            % (data.get("schema_version"), MANIFEST_SCHEMA_VERSION)
+        )
+    manifest_type = str(data.get("manifest_type", "") or "")
+    if expected_types and manifest_type not in set(expected_types):
+        raise ValueError(
+            "manifest type %r is not valid for this operation; expected %s"
+            % (manifest_type, ", ".join(expected_types))
+        )
+    if not isinstance(data.get("operations", []), list):
+        raise ValueError("manifest operations field is invalid")
+    return data
+
+
+def _prepare_undo_operation(
+    source_operation: Mapping[str, Any],
+) -> Tuple[Optional[Dict[str, Any]], str]:
+    """Build and preflight one journalled undo operation."""
+    operation_type = str(source_operation.get("type", "") or "")
+    source_steps = source_operation.get("steps", [])
+    if source_operation.get("status") != "completed":
+        return None, "operation was not completed"
+    if not isinstance(source_steps, list):
+        return None, "operation steps are invalid"
+
+    journal: Dict[str, Any] = {
+        "operation_id": str(uuid.uuid4()),
+        "source_operation_id": str(source_operation.get("operation_id", "") or ""),
+        "source_type": operation_type,
+        "record_path": str(source_operation.get("record_path", "") or ""),
+        "type": "",
+        "status": "pending",
+        "error": "",
+        "rollback_errors": [],
+        "steps": [],
+    }
+
+    if operation_type in {"move", "quarantine_duplicate_group"}:
+        reverse_steps: List[Dict[str, Any]] = []
+        transfers: List[Tuple[Path, Path]] = []
+        for source_step in reversed(source_steps):
+            if source_step.get("type") != "move" or source_step.get("status") != "done":
+                continue
+            source = Path(str(source_step.get("to", "")))
+            destination = Path(str(source_step.get("from", "")))
+            if not source.is_file() or source.is_symlink():
+                return None, f"undo source missing or unsafe: {source}"
+            if destination.exists() or destination.is_symlink():
+                return None, f"undo destination occupied: {destination}"
+            digest = str(source_step.get("sha256", "") or "")
+            if not digest:
+                digest = full_file_sha256(source)
+            elif full_file_sha256(source) != digest:
+                return None, f"undo source content no longer matches the apply journal: {source}"
+            identity = file_identity(source)
+            reverse_steps.append(
+                {
+                    "type": "move",
+                    "from": str(source),
+                    "to": str(destination),
+                    "status": "pending",
+                    "method": "",
+                    "sha256": digest,
+                    "size": str(identity.size),
+                    "source_identity": identity.to_dict(),
+                    "destination_identity": {},
+                    "staging_path": "",
+                }
+            )
+            transfers.append((source, destination))
+        if not reverse_steps:
+            return None, "completed operation contains no reversible move steps"
+        ready, reason = _preflight_transfers(transfers)
+        if not ready:
+            return None, reason
+        journal["type"] = "undo_move"
+        journal["steps"] = reverse_steps
+        return journal, "reversible move operation"
+
+    if operation_type == "hardlink_duplicate_group":
+        undo_steps: List[Dict[str, Any]] = []
+        for source_step in reversed(source_steps):
+            if source_step.get("status") != "done":
+                continue
+            step_type = str(source_step.get("type", "") or "")
+            if step_type == "hardlink-create":
+                canonical = Path(str(source_step.get("source", "")))
+                target = Path(str(source_step.get("target", "")))
+                if canonical.is_symlink() or not canonical.is_file():
+                    return None, f"canonical hard-link source is unavailable: {canonical}"
+                if target.is_symlink() or not target.is_file():
+                    return None, f"created hard-link target is unavailable: {target}"
+                if not same_inode(canonical, target):
+                    return None, f"created hard-link target was replaced: {target}"
+                undo_steps.append(
+                    {
+                        "type": "hardlink-remove",
+                        "canonical": str(canonical),
+                        "target": str(target),
+                        "status": "pending",
+                        "linked_identity": file_identity(target).to_dict(),
+                        "sha256": str(source_step.get("sha256", "") or ""),
+                    }
+                )
+            elif step_type == "hardlink-replace":
+                path = Path(str(source_step.get("path", "")))
+                canonical = Path(str(source_step.get("canonical", "")))
+                if path.is_symlink() or not path.is_file():
+                    return None, f"relinked path is unavailable: {path}"
+                if canonical.is_symlink() or not canonical.is_file():
+                    return None, f"canonical path is unavailable: {canonical}"
+                if not same_inode(path, canonical):
+                    return None, f"relinked path no longer points to canonical inode: {path}"
+                digest = str(source_step.get("sha256", "") or "")
+                if digest and full_file_sha256(path) != digest:
+                    return None, f"relinked path content changed after apply: {path}"
+                undo_steps.append(
+                    {
+                        "type": "hardlink-break",
+                        "path": str(path),
+                        "canonical": str(canonical),
+                        "status": "pending",
+                        "linked_identity": file_identity(path).to_dict(),
+                        "sha256": digest,
+                        "staging_path": "",
+                        "staging_identity": {},
+                        "backup_path": "",
+                        "backup_move": {},
+                        "replacement_identity": {},
+                        "backup_removed": False,
+                    }
+                )
+            else:
+                return None, f"unsupported hard-link journal step: {step_type}"
+        if not undo_steps:
+            return None, "completed hard-link operation contains no reversible steps"
+        journal["type"] = "undo_hardlink"
+        journal["steps"] = undo_steps
+        return journal, "reversible hard-link operation"
+
+    return None, f"unsupported operation type: {operation_type}"
+
+
+def _execute_undo_move_operation(
+    operation: MutableMapping[str, Any],
+    undo: MutableMapping[str, Any],
+    undo_path: Path,
+) -> Tuple[bool, List[str]]:
+    steps = operation.get("steps", [])
+    try:
+        for step in steps:
+            def staged(path: Path, current=step) -> None:
+                current["staging_path"] = str(path)
+                current["status"] = "staging"
+                _save_manifest(undo, undo_path)
+
+            def destination_created(identity: Mapping[str, Any], current=step) -> None:
+                current["destination_identity"] = dict(identity)
+                current["status"] = "publishing"
+                _save_manifest(undo, undo_path)
+
+            def published(result: Mapping[str, Any], current=step) -> None:
+                current.update(result)
+                current["status"] = "published"
+                _save_manifest(undo, undo_path)
+
+            result = safe_move(
+                Path(step["from"]),
+                Path(step["to"]),
+                expected_sha256=str(step.get("sha256", "") or ""),
+                on_staged=staged,
+                on_destination_created=destination_created,
+                on_published=published,
+            )
+            step.update(status="done", **result)
+            _save_manifest(undo, undo_path)
+    except Exception as exc:
+        rollback_errors = _rollback_move_steps(steps)
+        operation.update(
+            status="rollback_error" if rollback_errors else "rolled_back",
+            error=str(exc),
+            rollback_errors=rollback_errors,
+        )
+        _save_manifest(undo, undo_path)
+        return False, rollback_errors
+    operation["status"] = "completed"
+    _save_manifest(undo, undo_path)
+    return True, []
+
+
+def _rollback_undo_hardlink_steps(
+    steps: Sequence[MutableMapping[str, Any]],
+) -> List[str]:
+    """Restore the post-apply hard-link state after an interrupted undo."""
+    errors: List[str] = []
+    for step in reversed(steps):
+        step_type = str(step.get("type", "") or "")
+        try:
+            if step_type == "hardlink-remove":
+                canonical = Path(str(step.get("canonical", "")))
+                target = Path(str(step.get("target", "")))
+                if canonical.is_symlink() or not canonical.is_file():
+                    errors.append(f"canonical path is unavailable: {canonical}")
+                    continue
+                if target.is_symlink():
+                    errors.append(f"removed hard-link target became a symlink: {target}")
+                    continue
+                if target.exists():
+                    if not same_inode(canonical, target):
+                        errors.append(f"hard-link target was replaced during undo: {target}")
+                        continue
+                else:
+                    atomic_hardlink(canonical, target)
+                step["status"] = "rolled_back"
+            elif step_type == "hardlink-break":
+                errors.extend(_rollback_break_link_step(step))
+            else:
+                errors.append(f"unsupported undo hard-link step: {step_type}")
+        except Exception as exc:
+            errors.append(f"{step}: {exc}")
+    return errors
+
+
+def _execute_undo_hardlink_operation(
+    operation: MutableMapping[str, Any],
+    undo: MutableMapping[str, Any],
+    undo_path: Path,
+) -> Tuple[bool, List[str]]:
+    steps = operation.get("steps", [])
+    try:
+        for step in steps:
+            step_type = str(step.get("type", "") or "")
+            if step_type == "hardlink-remove":
+                canonical = Path(str(step["canonical"]))
+                target = Path(str(step["target"]))
+                linked_identity = step.get("linked_identity", {})
+                if linked_identity and not _matches_stable_identity(target, linked_identity):
+                    raise ValueError(f"hard-link target changed before undo: {target}")
+                if not same_inode(canonical, target):
+                    raise ValueError(f"hard-link target no longer points to canonical inode: {target}")
+                step["status"] = "removing"
+                _save_manifest(undo, undo_path)
+                target.unlink()
+                _fsync_directory(target.parent)
+                step["status"] = "done"
+                _save_manifest(undo, undo_path)
+            elif step_type == "hardlink-break":
+                _journaled_break_link_step(
+                    step,
+                    lambda: _save_manifest(undo, undo_path),
+                )
+            else:
+                raise ValueError(f"unsupported undo hard-link step: {step_type}")
+    except Exception as exc:
+        rollback_errors = _rollback_undo_hardlink_steps(steps)
+        operation.update(
+            status="rollback_error" if rollback_errors else "rolled_back",
+            error=str(exc),
+            rollback_errors=rollback_errors,
+        )
+        _save_manifest(undo, undo_path)
+        return False, rollback_errors
+    operation["status"] = "completed"
+    _save_manifest(undo, undo_path)
+    return True, []
+
+
+def _journal_paths(payload: Mapping[str, Any]) -> Set[str]:
+    """Return all public paths mentioned by a manifest or undo journal."""
+    paths: Set[str] = set()
+    for top_level in ("source_csv", "undo_of", "recovery_of"):
+        value = str(payload.get(top_level, "") or "")
+        if value:
+            paths.add(normal_path_key(Path(value)))
+    for operation in payload.get("operations", []):
+        if not isinstance(operation, Mapping):
+            continue
+        for step in operation.get("steps", []):
+            if not isinstance(step, Mapping):
+                continue
+            for field in (
+                "from", "to", "source", "target", "path", "canonical",
+                "backup_path", "staging_path",
+            ):
+                value = str(step.get(field, "") or "")
+                if value:
+                    paths.add(normal_path_key(Path(value)))
+            backup_move = step.get("backup_move", {})
+            if isinstance(backup_move, Mapping):
+                for field in ("from", "to", "staging_path"):
+                    value = str(backup_move.get(field, "") or "")
+                    if value:
+                        paths.add(normal_path_key(Path(value)))
+    return paths
+
+
+def _load_undo_manifest(path: Path) -> Dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        data = json.load(handle)
+    if not isinstance(data, dict):
+        raise ValueError("undo manifest root is not an object")
+    if str(data.get("schema_name", "")) != UNDO_SCHEMA_NAME:
+        raise ValueError("unrecognised undo schema name %r" % data.get("schema_name"))
+    if str(data.get("schema_version", "")) != UNDO_SCHEMA_VERSION:
+        raise ValueError(
+            "unsupported undo schema %r; expected %s"
+            % (data.get("schema_version"), UNDO_SCHEMA_VERSION)
+        )
+    if str(data.get("manifest_type", "") or "") != "undo":
+        raise ValueError("undo manifest type is not 'undo'")
+    if not isinstance(data.get("operations", []), list):
+        raise ValueError("undo manifest operations field is invalid")
+    return data
+
+
+def undo_manifest(
+    manifest_path: Path,
+    apply_changes: bool = False,
+    output_manifest: Optional[Path] = None,
+) -> int:
+    try:
+        manifest = _load_manifest(manifest_path)
+    except Exception as exc:
+        print(f"ERROR: could not read manifest: {exc}")
+        return 1
+
+    prepared: List[Dict[str, Any]] = []
+    failures: List[str] = []
+    for source_operation in reversed(manifest.get("operations", [])):
+        label = source_operation.get("record_path", source_operation.get("operation_id", "unknown"))
+        journal, reason = _prepare_undo_operation(source_operation)
+        print(f"[{'UNDO-CHECK' if apply_changes else 'DRY-UNDO'}] {label}")
+        if journal is None:
+            failures.append(f"{label}: {reason}")
+            print(f"       blocked: {reason}")
+        else:
+            prepared.append(journal)
+            print(f"       {reason}")
+
+    # Undo is preflighted as a whole. A known-bad operation must not leave an
+    # earlier operation reversed while a later one remains applied.
+    if failures:
+        print(f"Undo preflight failed. reversible={len(prepared)} blocked={len(failures)}")
+        return 1
+    if not apply_changes:
+        print(f"Undo dry run complete. reversible={len(prepared)} failures=0")
+        return 0
+
+    undo = undo_header()
+    undo.update(
+        manifest_type="undo",
+        manifest_id=str(uuid.uuid4()),
+        created_utc=datetime.now(timezone.utc).isoformat(),
+        updated_utc=datetime.now(timezone.utc).isoformat(),
+        undo_of=str(manifest_path),
+        status="in_progress",
+        operations=prepared,
+    )
+    output_manifest = absolute_without_resolving(
+        output_manifest
+        or manifest_path.with_name(f"{manifest_path.stem}_undo_{_utc_stamp()}.json")
+    )
+    protected = _journal_paths(manifest) | _journal_paths(undo) | {normal_path_key(manifest_path)}
+    if normal_path_key(output_manifest) in protected:
+        print("ERROR: undo manifest overlaps the source journal or an operation path")
+        return 1
+    if output_manifest.exists() or output_manifest.is_symlink():
+        print(f"ERROR: undo manifest already exists: {output_manifest}")
+        return 1
+    try:
+        _create_manifest(undo, output_manifest)
+    except Exception as exc:
+        print(f"ERROR: could not create undo manifest: {exc}")
+        return 1
+
+    completed = 0
+    rolled_back = 0
+    errors = 0
+    for operation in undo["operations"]:
+        print(f"[UNDO] {operation.get('record_path', operation.get('operation_id', 'unknown'))}")
+        if operation.get("type") == "undo_move":
+            success, rollback_errors = _execute_undo_move_operation(
+                operation, undo, output_manifest
+            )
+        elif operation.get("type") == "undo_hardlink":
+            success, rollback_errors = _execute_undo_hardlink_operation(
+                operation, undo, output_manifest
+            )
+        else:
+            operation.update(status="rollback_error", error="unsupported undo operation")
+            _save_manifest(undo, output_manifest)
+            success, rollback_errors = False, ["unsupported undo operation"]
+        if success:
+            completed += 1
+        elif rollback_errors:
+            errors += 1
+        else:
+            rolled_back += 1
+
+    if any(op.get("status") in {"pending", "rollback_error"} for op in undo["operations"]):
+        undo["status"] = "attention_required"
+    elif rolled_back:
+        undo["status"] = "completed_with_rollbacks"
+    else:
+        undo["status"] = "completed"
+    _save_manifest(undo, output_manifest)
+    print(
+        f"Undo complete. completed={completed} rolled_back={rolled_back} errors={errors}"
+    )
+    print(f"Undo manifest: {output_manifest}")
+    return 1 if errors or rolled_back else 0
+
+
+def _analyze_move_rollback_steps(steps: Sequence[Mapping[str, Any]]) -> List[str]:
+    errors: List[str] = []
+    for step in reversed(steps):
+        source = Path(str(step.get("from", "")))
+        destination = Path(str(step.get("to", "")))
+        if source.is_symlink() or destination.is_symlink():
+            errors.append(f"rollback path is a symlink: {destination} -> {source}")
+            continue
+        source_exists = source.is_file()
+        destination_exists = destination.is_file()
+        if source_exists and destination_exists:
+            recorded_destination = step.get("destination_identity", {})
+            owned = (
+                isinstance(recorded_destination, Mapping)
+                and bool(recorded_destination)
+                and identity_matches(destination, recorded_destination)
+            )
+            if not _same_regular_content(source, destination) and not owned:
+                errors.append(f"both rollback paths have different content: {source} and {destination}")
+        elif not source_exists and destination_exists:
+            if source.exists() or source.is_symlink():
+                errors.append(f"rollback destination is occupied: {source}")
+        elif source_exists and not destination_exists:
+            pass
+        else:
+            errors.append(f"neither rollback path exists: {source} / {destination}")
+        staging_text = str(step.get("staging_path", "") or "")
+        if staging_text and Path(staging_text).is_symlink():
+            errors.append(f"staging path became a symlink: {staging_text}")
+    return errors
+
+
+def _analyze_relink_rollback_step(step: Mapping[str, Any]) -> List[str]:
+    path = Path(str(step.get("path", "")))
+    canonical = Path(str(step.get("canonical", "")))
+    backup_text = str(step.get("backup_path", "") or "")
+    backup = Path(backup_text) if backup_text else None
+    if canonical.is_symlink() or not canonical.is_file():
+        return [f"canonical path is unavailable: {canonical}"]
+    if path.is_symlink() or (backup is not None and backup.is_symlink()):
+        return [f"relink rollback contains a symlink path: {path} / {backup}"]
+    path_exists = path.is_file()
+    backup_exists = bool(backup and backup.is_file())
+    path_is_link = path_exists and same_inode(path, canonical)
+    if backup_exists:
+        if path_exists and not path_is_link:
+            before = step.get("before_identity", {})
+            if not (isinstance(before, Mapping) and identity_matches(path, before)):
+                return [f"cannot restore relink backup because path is occupied: {path}"]
+        return []
+    if path_is_link:
+        return []
+    before = step.get("before_identity", {})
+    if path_exists and isinstance(before, Mapping) and identity_matches(path, before):
+        return []
+    return [f"cannot determine a safe relink rollback for {path}"]
+
+
+def _analyze_hardlink_rollback_steps(steps: Sequence[Mapping[str, Any]]) -> List[str]:
+    errors: List[str] = []
+    for step in reversed(steps):
+        step_type = str(step.get("type", "") or "")
+        if step_type == "hardlink-create":
+            source = Path(str(step.get("source", "")))
+            target = Path(str(step.get("target", "")))
+            if target.is_symlink():
+                errors.append(f"hard-link target became a symlink: {target}")
+            elif target.exists() and (
+                source.is_symlink() or not source.is_file() or not same_inode(source, target)
+            ):
+                errors.append(f"hard-link target no longer points to its source: {target}")
+        elif step_type == "hardlink-replace":
+            errors.extend(_analyze_relink_rollback_step(step))
+        else:
+            errors.append(f"unsupported hard-link journal step: {step_type}")
+    return errors
+
+
+def _analyze_break_link_rollback_step(step: Mapping[str, Any]) -> List[str]:
+    path = Path(str(step.get("path", "")))
+    canonical = Path(str(step.get("canonical", "")))
+    backup_text = str(step.get("backup_path", "") or "")
+    backup = Path(backup_text) if backup_text else None
+    if canonical.is_symlink() or not canonical.is_file():
+        return [f"canonical path is unavailable: {canonical}"]
+    if path.is_symlink() or (backup is not None and backup.is_symlink()):
+        return [f"undo rollback contains a symlink path: {path} / {backup}"]
+    path_exists = path.is_file()
+    path_is_link = path_exists and same_inode(path, canonical)
+    backup_exists = bool(backup and backup.is_file())
+    if backup_exists:
+        if path_exists and not path_is_link:
+            replacement = step.get("replacement_identity", {})
+            digest = str(step.get("sha256", "") or "")
+            owned = isinstance(replacement, Mapping) and bool(replacement) and identity_matches(path, replacement)
+            if not owned and digest:
+                try:
+                    owned = full_file_sha256(path) == digest
+                except OSError:
+                    owned = False
+            if not owned:
+                return [f"public path was replaced during undo: {path}"]
+        return []
+    if path_is_link:
+        return []
+    if path_exists:
+        digest = str(step.get("sha256", "") or "")
+        if digest:
+            try:
+                if full_file_sha256(path) != digest:
+                    return [f"independent path content changed during undo: {path}"]
+            except OSError as exc:
+                return [f"could not inspect independent path {path}: {exc}"]
+        return []
+    return [f"neither linked path nor undo backup exists: {path}"]
+
+
+def _analyze_undo_hardlink_rollback_steps(steps: Sequence[Mapping[str, Any]]) -> List[str]:
+    errors: List[str] = []
+    for step in reversed(steps):
+        step_type = str(step.get("type", "") or "")
+        if step_type == "hardlink-remove":
+            canonical = Path(str(step.get("canonical", "")))
+            target = Path(str(step.get("target", "")))
+            if canonical.is_symlink() or not canonical.is_file():
+                errors.append(f"canonical path is unavailable: {canonical}")
+            elif target.is_symlink():
+                errors.append(f"hard-link target became a symlink: {target}")
+            elif target.exists() and not same_inode(canonical, target):
+                errors.append(f"hard-link target was replaced during undo: {target}")
+        elif step_type == "hardlink-break":
+            errors.extend(_analyze_break_link_rollback_step(step))
+        else:
+            errors.append(f"unsupported undo hard-link step: {step_type}")
+    return errors
+
+
+def _load_recoverable_journal(path: Path) -> Tuple[Dict[str, Any], str]:
+    with path.open("r", encoding="utf-8") as handle:
+        probe = json.load(handle)
+    if not isinstance(probe, dict):
+        raise ValueError("journal root is not an object")
+    schema_name = str(probe.get("schema_name", "") or "")
+    if schema_name == MANIFEST_SCHEMA_NAME:
+        return _load_manifest(path, expected_types=("apply",)), "apply"
+    if schema_name == UNDO_SCHEMA_NAME:
+        return _load_undo_manifest(path), "undo"
+    raise ValueError(f"unrecognised recoverable journal schema {schema_name!r}")
+
+
+def recover_manifest(
+    manifest_path: Path,
+    apply_changes: bool = False,
+    output_manifest: Optional[Path] = None,
+) -> int:
+    """Roll back journaled completed steps from interrupted operations."""
+    try:
+        manifest, journal_kind = _load_recoverable_journal(manifest_path)
+    except Exception as exc:
+        print(f"ERROR: could not read manifest: {exc}")
+        return 1
+
+    candidates = [
+        operation
+        for operation in manifest.get("operations", [])
+        if operation.get("status") in {"pending", "rollback_error"}
+    ]
+    if not candidates:
+        print("No interrupted operations require recovery.")
+        return 0
+
+    recovery = manifest_header("recovery")
+    recovery.update(
+        manifest_id=str(uuid.uuid4()),
+        created_utc=datetime.now(timezone.utc).isoformat(),
+        recovery_of=str(manifest_path),
+        status="in_progress" if apply_changes else "dry_run",
+        operations=[],
+    )
+    if apply_changes:
+        output_manifest = absolute_without_resolving(
+            output_manifest
+            or manifest_path.with_name(f"{manifest_path.stem}_recovery_{_utc_stamp()}.json")
+        )
+        protected = _journal_paths(manifest) | {normal_path_key(manifest_path)}
+        if normal_path_key(output_manifest) in protected:
+            print("ERROR: recovery manifest overlaps the source journal or an operation path")
+            return 1
+        if output_manifest.exists() or output_manifest.is_symlink():
+            print(f"ERROR: recovery manifest already exists: {output_manifest}")
+            return 1
+        try:
+            _create_manifest(recovery, output_manifest)
+        except Exception as exc:
+            print(f"ERROR: could not create recovery manifest: {exc}")
+            return 1
+
+    failures = 0
+    for operation in reversed(candidates):
+        op_type = operation.get("type", "")
+        steps = operation.get("steps", []) if isinstance(operation.get("steps", []), list) else []
+        print(f"{'[RECOVER]' if apply_changes else '[DRY-RECOVER]'} {operation.get('record_path', '')}")
+        errors: List[str] = []
+        if journal_kind == "apply" and op_type in {"move", "quarantine_duplicate_group"}:
+            errors = _rollback_move_steps(steps) if apply_changes else _analyze_move_rollback_steps(steps)
+        elif journal_kind == "apply" and op_type == "hardlink_duplicate_group":
+            errors = _rollback_hardlink_steps(steps) if apply_changes else _analyze_hardlink_rollback_steps(steps)
+        elif journal_kind == "undo" and op_type == "undo_move":
+            errors = _rollback_move_steps(steps) if apply_changes else _analyze_move_rollback_steps(steps)
+        elif journal_kind == "undo" and op_type == "undo_hardlink":
+            errors = (
+                _rollback_undo_hardlink_steps(steps)
+                if apply_changes
+                else _analyze_undo_hardlink_rollback_steps(steps)
+            )
+        else:
+            errors = [f"unsupported interrupted {journal_kind} operation type: {op_type}"]
+        status = "recovered" if not errors else "failed"
+        recovery["operations"].append(
+            {
+                "source_operation_id": operation.get("operation_id", ""),
+                "status": status if apply_changes else ("recoverable" if not errors else "blocked"),
+                "errors": errors,
+            }
+        )
+        failures += bool(errors)
+        if apply_changes:
+            write_json_atomic(recovery, output_manifest)
+
+    if apply_changes:
+        recovery["status"] = "completed" if not failures else "attention_required"
+        write_json_atomic(recovery, output_manifest)
+        print(f"Recovery complete. failures={failures}")
+        print(f"Recovery manifest: {output_manifest}")
+    else:
+        print(
+            f"Recovery dry run complete. candidates={len(candidates)} "
+            f"blocked={failures}"
+        )
+    return 1 if failures else 0
