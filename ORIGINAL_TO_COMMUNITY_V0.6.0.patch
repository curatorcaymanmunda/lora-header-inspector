@@ -0,0 +1,230 @@
+"""Small, dependency-free utilities."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Mapping, Set, TypeVar
+
+from .constants import FALSY, HASH_CHUNK_BYTES, TRUTHY, WINDOWS_RESERVED_NAMES
+
+T = TypeVar("T")
+
+
+def truthy(value: Any) -> bool:
+    return str(value).strip().lower() in TRUTHY
+
+
+def explicitly_false(value: Any) -> bool:
+    return str(value).strip().lower() in FALSY
+
+
+def unique(items: Iterable[T]) -> List[T]:
+    seen: Set[T] = set()
+    result: List[T] = []
+    for item in items:
+        if item not in seen:
+            seen.add(item)
+            result.append(item)
+    return result
+
+
+def join_semicolon(items: Iterable[str]) -> str:
+    return ";".join(value for value in unique(item for item in items if item))
+
+
+def split_semicolon(value: Any) -> List[str]:
+    return [item.strip() for item in str(value or "").split(";") if item.strip()]
+
+
+def absolute_without_resolving(path: Path) -> Path:
+    """Return an absolute path without dereferencing the final symlink."""
+    return Path(os.path.abspath(os.fspath(path)))
+
+
+def normal_path_key(path: Path) -> str:
+    return os.path.normcase(os.path.abspath(os.fspath(path)))
+
+
+def resolved_destination(path: Path) -> Path:
+    """Resolve an existing parent chain without requiring the leaf to exist."""
+    return path.parent.resolve(strict=False) / path.name
+
+
+def is_relative_to(path: Path, base: Path) -> bool:
+    try:
+        path.relative_to(base)
+        return True
+    except ValueError:
+        return False
+
+
+def safe_component(value: Any, fallback: str = "Unsorted", limit: int = 120) -> str:
+    """Create a portable path component for Windows, macOS, and Linux."""
+    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", str(value).strip())
+    cleaned = re.sub(r"\s+", " ", cleaned).strip(" .")
+    if not cleaned:
+        cleaned = fallback
+    if cleaned.split(".", 1)[0].upper() in WINDOWS_RESERVED_NAMES:
+        cleaned = "_" + cleaned
+    return cleaned[:limit]
+
+
+def utc_stamp() -> str:
+    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
+
+
+def utc_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def atomic_json_write(data: Mapping[str, Any], path: Path) -> None:
+    path = absolute_without_resolving(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temp_name = tempfile.mkstemp(
+        prefix=path.name + ".", suffix=".tmp", dir=str(path.parent)
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(data, handle, indent=2, ensure_ascii=False, sort_keys=False)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temp_name, path)
+        fsync_directory(path.parent)
+    except Exception:
+        try:
+            os.unlink(temp_name)
+        except OSError:
+            pass
+        raise
+
+
+def create_json_exclusive(data: Mapping[str, Any], path: Path) -> None:
+    """Create a JSON file only when the public path is still absent.
+
+    Initial operation journals use this instead of replace semantics.  A crash
+    while writing can leave an incomplete journal, but it happens before any
+    filesystem mutation and, crucially, can never overwrite a file that won a
+    race for the requested path.
+    """
+    path = absolute_without_resolving(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    descriptor = os.open(str(path), flags, 0o600)
+    owned = os.fstat(descriptor)
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+            descriptor = -1
+            json.dump(data, handle, indent=2, ensure_ascii=False, sort_keys=False)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        fsync_directory(path.parent)
+    except Exception:
+        if descriptor >= 0:
+            try:
+                os.close(descriptor)
+            except OSError:
+                pass
+        try:
+            current = path.stat()
+            if (current.st_dev, current.st_ino) == (owned.st_dev, owned.st_ino):
+                path.unlink()
+                fsync_directory(path.parent)
+        except OSError:
+            pass
+        raise
+
+
+def atomic_text_write(text: str, path: Path) -> None:
+    path = absolute_without_resolving(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temp_name = tempfile.mkstemp(
+        prefix=path.name + ".", suffix=".tmp", dir=str(path.parent)
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
+            handle.write(text)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temp_name, path)
+        fsync_directory(path.parent)
+    except Exception:
+        try:
+            os.unlink(temp_name)
+        except OSError:
+            pass
+        raise
+
+
+def fsync_directory(path: Path) -> None:
+    """Best-effort directory fsync on platforms that support it."""
+    if os.name == "nt":
+        return
+    flags = getattr(os, "O_DIRECTORY", 0) | os.O_RDONLY
+    try:
+        fd = os.open(str(path), flags)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+
+
+def sha256_file(path: Path, chunk_size: int = HASH_CHUNK_BYTES) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def stable_id(prefix: str, *parts: Any, length: int = 20) -> str:
+    digest = hashlib.sha256()
+    for part in parts:
+        digest.update(str(part).encode("utf-8", "surrogatepass"))
+        digest.update(b"\0")
+    return "%s-%s" % (prefix, digest.hexdigest()[:length])
+
+
+def json_loads_list(value: Any) -> List[Any]:
+    text = str(value or "").strip()
+    if not text:
+        return []
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError:
+        return [part for part in text.split(";") if part]
+    return parsed if isinstance(parsed, list) else []
+
+
+def json_loads_dict(value: Any) -> Dict[str, Any]:
+    text = str(value or "").strip()
+    if not text:
+        return {}
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError:
+        return {}
+    return parsed if isinstance(parsed, dict) else {}
+
+
+def same_file_identity(first: Path, second: Path) -> bool:
+    try:
+        a = first.stat()
+        b = second.stat()
+    except OSError:
+        return False
+    return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
