-        if not expanded:
-            print(f"No matches for: {argument}")
-        for path in expanded:
-            if path.suffix.lower() != ".safetensors":
-                continue
-            key = _dedupe_key(path)
-            if key in seen:
-                continue
-            seen.add(key)
-            files.append(path)
-    return files
