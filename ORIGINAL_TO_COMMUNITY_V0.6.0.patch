+    wan_self = _has(keys, r"(?:^|[._])blocks[._]\d+[._]self_attn(?:[._]|$)")
+    wan_cross = _has(keys, r"(?:^|[._])blocks[._]\d+[._]cross_attn(?:[._]|$)")
+    wan_ffn = _has(keys, r"(?:^|[._])blocks[._]\d+[._]ffn(?:[._]|$)")
